<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
        <GamemodeId>nfmm/rocket</GamemodeId>
    </PropertyGroup>

    <Import Project="..\Plugin.props"/>

    <!-- The plugin's own assets. They land in the plugin's output directory, which Plugin.props
         copies wholesale into data/gamemodes/<id>/, so a plugin folder is self-contained. -->
    <ItemGroup>
        <None Include="sound\**\*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\FixedMathSharp\src\FixedMathSharp\FixedMathSharp.csproj" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.Mathematics\Maxine.Extensions.Mathematics.csproj" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="..\NFMWorld.DriverInterface\NFMWorld.DriverInterface.csproj" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="..\NFMWorld.Math\NFMWorld.Math.csproj" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="..\TightPack\src\TightPack\TightPack.csproj" Private="false" ExcludeAssets="runtime"/>

        <ProjectReference Include="..\TightPack\src\TightPack.Generator\TightPack.Generator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The GL command buffer hands raw element-buffer offsets to Silk.NET's DrawElementsBaseVertex
             as void*, the same way the ANGLE backend does. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The backend is x64-only on Windows for the same reason the ANGLE one is: it must match the
             process, and pinning keeps the build from silently producing an x86 host this was never
             verified against. Desktop GL has no native library of its own to match, but the
             constraint is kept so the two GL backends cannot diverge in bitness. -->
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <!-- Desktop GL, not GLES: this backend targets a core-profile desktop context and compiles the
             bundles' Glsl330 form. The four GLES extension packages the ANGLE backend needs
             (ANGLE/EXT/OES) are deliberately absent - they exist there for the base-vertex and
             compressed-texture extensions, and the desktop core covers both natively. -->
        <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
    </ItemGroup>

    <!-- Same reason as the ANGLE backend: the capability facts this backend's compiler work exists to
         check - that every reflected texture resolves to a real sampler uniform, and that the driver's
         std140 block layout matches the reflection's byte offsets - live on internal types
         (GlShaderProgram.TextureLocations, GlUniformBlock) and are checked through
         GlGraphicsDevice.Gl for entry points the abstraction does not expose. -->
    <ItemGroup>
        <InternalsVisibleTo Include="NFMWorld.Graphics.DesktopGL.Smoke" />
    </ItemGroup>

</Project>

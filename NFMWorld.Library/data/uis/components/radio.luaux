--!strict
-- Radio / RadioGroup — reusable fine-grained reactive radio controls for Sx.
--
-- `Radio` is a single item (circular indicator + optional reactive label).
-- `RadioGroup<T>` wraps a list of `{ label, value }` options and owns the shared
-- selection, rendering one `Radio` per option.

local Sx = require("../../library/sx/index")
local x = Sx.x
local theme = require("../../library/ui/theme")

export type RadioProps = {
	checked: Sx.Signalish<boolean>,
	onSelect: () -> (),
	label: Sx.Signalish<string>?,
	disabled: boolean?,
	size: number?,
}

local function Radio(props: RadioProps)
	local size = props.size or 16
	local disabled = props.disabled == true
	local dot = math.max(4, math.floor(size * 0.5 + 0.5))
	local hovered, setHovered = Sx.createSignal(false)

	return <Sx.View
		style={{
			display = "flex",
			flexDirection = "row",
			alignItems = "center",
			gap = 8,
		}}
		onmousedown={function()
			if disabled then return end
			props.onSelect()
		end}
		onmouseenter={function()
			setHovered(true)
		end}
		onmouseleave={function()
			setHovered(false)
		end}>
		<Sx.View
			style={Sx.createMemo(function(): Sx.Styles
				local checked = Sx.read(props.checked)
				local hov = hovered() and not disabled
				return {
					width = size,
					height = size,
					flexShrink = 0,
					display = "flex",
					flexDirection = "row",
					alignItems = "center",
					justifyContent = "center",
					backgroundColor = "transparent",
					borderWidth = 2,
					borderColor = checked and theme.accent or (hov and "rgba(255,255,255,0.55)" or "rgba(255,255,255,0.3)"),
					borderRadius = size / 2,
				}
			end)}>
			<Sx.View style={Sx.createMemo(function(): Sx.Styles
				local checked = Sx.read(props.checked)
				return {
					width = dot,
					height = dot,
					backgroundColor = checked and theme.accent or "transparent",
					borderRadius = dot / 2,
				}
			end)} />
		</Sx.View>
		<Sx.Text style={Sx.createMemo(function(): Sx.TextStyles
			local checked = Sx.read(props.checked)
			return {
				fontSize = 13,
				color = disabled
					and "rgba(255,255,255,0.3)"
					or (checked and "#fff" or "rgba(255,255,255,0.7)"),
			}
		end)}>
			{function()
				local label = props.label
				if label == nil then return "" end
				return Sx.read(label)
			end}
		</Sx.Text>
	</Sx.View>
end

export type RadioGroupProps<T> = {
	value: Sx.Signalish<T>,
	onChange: (T) -> (),
	options: { { label: string, value: T } },
	disabled: boolean?,
	direction: "column" | "row"?,
}

local function RadioGroup<T>(props: RadioGroupProps<T>)
	local direction = props.direction or "column"
	local disabled = props.disabled == true

	return <Sx.View
		style={{
			display = "flex",
			flexDirection = direction,
			gap = 10,
		}}>
		<Sx.For<<{ label: string, value: T }>>
			each={props.options}>
			{function(item: () -> { label: string, value: T }, _index: number)
				local opt = item()
				return x(Radio) {
					checked = function() return Sx.read(props.value) == opt.value end,
					onSelect = function() props.onChange(opt.value) end,
					label = opt.label,
					disabled = disabled,
				}
			end}
		</Sx.For>
	</Sx.View>
end

return {
	Radio = Radio,
	RadioGroup = RadioGroup,
}

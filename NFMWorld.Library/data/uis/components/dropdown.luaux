--!strict
-- Dropdown — reusable fine-grained reactive popup dropdown for Sx.
--
-- Controlled component: `value` (the selected option's numeric value, signal/accessor)
-- + `onSelect`. `options` may be a list of strings (values 0..n-1) or a list of
-- { label, value }. Opens a popup below the trigger; closes on outside click (blur),
-- on selecting an option, or on re-clicking the trigger.
--
-- A real dropdown (not the click-to-cycle Select in settings.luau). The popup is
-- absolutely positioned below the trigger with zIndex = 1000, so it is painted and
-- hit-tested above later tree siblings (z-index aware render order + FocusManager
-- hit test). Inside `overflow: hidden/scroll` parents it may still be clipped.
-- Open/close is driven purely by the trigger toggle + selecting an option (no
-- focus/blur), so it re-opens reliably after a selection. There is no click-outside
-- close (no full-screen scoped backdrop).

local Sx = require("../../library/sx/index")
local x = Sx.x
local theme = require("../../library/ui/theme")

export type DropdownOption = { label: string, value: number }
export type DropdownProps = {
	options: { string } | { DropdownOption },
	value: Sx.Signalish<number?>,
	onSelect: (number) -> (),
	placeholder: string?,
	width: number?,
	disabled: boolean?,
}

-- Normalize string lists (index-based values) or { label, value } lists to rows.
local function toRows(options: { string } | { DropdownOption }): { DropdownOption }
	local rows: { DropdownOption } = {}
	if #options == 0 then return rows end
	if type(options[1]) == "string" then
		for i = 1, #options do
			rows[i] = { label = options[i] :: string, value = i - 1 }
		end
	else
		for i = 1, #options do
			rows[i] = options[i] :: DropdownOption
		end
	end
	return rows
end

local function Dropdown(props: DropdownProps)
	local rows = toRows(props.options)
	local width = props.width or 160
	local disabled = props.disabled == true
	local placeholder = props.placeholder or "Select..."

	local open, setOpen = Sx.createSignal(false)
	local hovered, setHovered = Sx.createSignal(false)
	local openUp, setOpenUp = Sx.createSignal(false)

	-- ref to the trigger host component, so we can read its screen position + the
	-- current scissor rect (visible region) to decide which way to open the popup.
	local triggerRef: { current: any? } = { current = nil }

	-- Row height estimate for the popup (padding 7+7 + ~18px line) and its max height.
	local ROW_H = 32
	local MAX_H = 200

	-- Open upward when the popup (estimated height) would overflow the bottom of the
	-- trigger's visible region (scissor rect). Falls back to downward when we can't
	-- read layout metrics (e.g. the fake test host, or pre-first-render).
	local function computeOpenUp(): boolean
		local el = triggerRef.current
		if el == nil then return false end
		local pos = el.layoutMarginPosition
		local size = el.layoutMarginSize
		local scissor = el.scissorRect
		if pos == nil or size == nil or scissor == nil then return false end
		local triggerBottom = pos.y + size.y
		local popupHeight = math.min(#rows * ROW_H, MAX_H)
		local spaceBelow = (scissor.y + scissor.height) - triggerBottom
		return popupHeight > spaceBelow
	end

	local function selectedLabel()
		local v = Sx.read(props.value)
		if v == nil then return placeholder end
		for _, row in ipairs(rows) do
			if row.value == v then return row.label end
		end
		return placeholder
	end

	-- Per-option row: its own hover signal so only the hovered option re-renders.
	local function DropdownOptionRow(props: { opt: DropdownOption, value: Sx.Signalish<number?>, onSelect: (number) -> () })
		local hovered, setHovered = Sx.createSignal(false)
		return <Sx.View
			style={Sx.createMemo(function(): Sx.Styles
				local v = Sx.read(props.value)
				local selected = v ~= nil and v == props.opt.value
				return {
					paddingTop = 7,
					paddingBottom = 7,
					paddingLeft = 12,
					paddingRight = 12,
					backgroundColor = selected and "rgba(79,195,247,0.18)"
						or (hovered() and "rgba(255,255,255,0.08)" or "transparent"),
					flexShrink = 0,
				}
			end)}
			onmousedown={function()
				if disabled then return end
				props.onSelect(props.opt.value)
				setOpen(false)
			end}
			onmouseenter={function()
				setHovered(true)
			end}
			onmouseleave={function()
				setHovered(false)
			end}>
			<Sx.Text
				style={Sx.createMemo(function(): Sx.TextStyles
					local v = Sx.read(props.value)
					local selected = v ~= nil and v == props.opt.value
					return {
						fontSize = 13,
						color = selected and theme.accent or (hovered() and "#fff" or "rgba(255,255,255,0.8)"),
					}
				end)}>
				{props.opt.label}
			</Sx.Text>
		</Sx.View>
	end

	return <Sx.View style={{ position = "relative", width = width }}>
		<Sx.View
			ref={triggerRef}
			tabindex={0}
			style={Sx.createMemo(function(): Sx.Styles
				local isOpen = open()
				local hov = hovered() and not disabled
				return {
					display = "flex",
					flexDirection = "row",
					alignItems = "center",
					justifyContent = "space-between",
					gap = 8,
					paddingTop = 8,
					paddingBottom = 8,
					paddingLeft = 12,
					paddingRight = 12,
					backgroundColor = "rgba(255,255,255,0.06)",
					borderWidth = 1,
					borderColor = isOpen and "rgba(79,195,247,0.6)" or (hov and "rgba(255,255,255,0.4)" or "rgba(255,255,255,0.15)"),
					borderRadius = 6,
				}
			end)}
			onmousedown={function()
				if disabled then return end
				setOpenUp(computeOpenUp())
				setOpen(not open())
			end}
			onblur={function()
				if disabled then return end
				setOpen(false)
			end}
			onmouseenter={function()
				setHovered(true)
			end}
			onmouseleave={function()
				setHovered(false)
			end}>
			<Sx.Text
				style={Sx.createMemo(function(): Sx.TextStyles
					local isOpen = open()
					return { fontSize = 13, color = isOpen and "#fff" or "rgba(255,255,255,0.8)" }
				end)}>
				{selectedLabel()}
			</Sx.Text>
			<Sx.Text style={{ fontSize = 12, color = "rgba(255,255,255,0.5)", flexShrink = 0 }}>▾</Sx.Text>
		</Sx.View>
		<Sx.Show when={open()}>
			<Sx.View
				style={Sx.createMemo(function(): Sx.Styles
					local up = openUp()
					local popupStyle: Sx.Styles = {
						position = "absolute",
						left = 0,
						width = "100%",
						display = "flex",
						flexDirection = "column",
						zIndex = 1000,
						backgroundColor = "rgba(20,24,32,0.98)",
						borderWidth = 1,
						borderColor = "rgba(255,255,255,0.15)",
						borderRadius = 6,
						overflow = "scroll",
						maxHeight = 200,
					}
					if up then
						popupStyle.bottom = "100%"
					else
						popupStyle.top = "100%"
					end
					return popupStyle
				end)}>
				<Sx.For<<DropdownOption>>>
					each={rows}
					{function(item: () -> DropdownOption, _index: number)
						return <DropdownOptionRow
							opt={item()}
							value={props.value}
							onSelect={props.onSelect}
						/>
					end}
				</Sx.For>
			</Sx.View>
		</Sx.Show>
	</Sx.View>
end

return Dropdown

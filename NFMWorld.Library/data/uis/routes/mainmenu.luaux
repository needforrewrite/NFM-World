--!strict
-- Sx port of the main menu. Fine-grained: components run once; the page stack and
-- account are signals; the item list is a keyed For; reactive text children update via
-- single commitTextUpdate calls. No vdom diffing, no per-frame re-render.

local Sx = require("../../library/sx/index")
local styled = Sx.styled
local x = Sx.x
local theme = require("../../library/ui/theme")

local Settings = require("../components/settings")

-- ── Types ────────────────────────────────────────────────────────

type MenuItem = {
	label: string,
	description: string,
	action: () -> (),
}

type MenuPage = {
	title: string,
	items: { MenuItem },
}

-- ── Styled components ────────────────────────────────────────────

local Root = styled(Sx.View) {
	width = "100%",
	height = "100%",
	display = "flex",
	flexDirection = "column",
	alignItems = "center",
	justifyContent = "center",
}

local PageTitle = styled(Sx.Text) {
	fontSize = 48,
	fontStyle = "bold",
	fontFamily = "Adventure",
	marginBottom = 8,
}

local Subtitle = styled(Sx.Text) {
	fontSize = 14,
	color = "rgba(255,255,255,0.5)",
	marginBottom = 40,
}

local Items = styled(Sx.View) {
	display = "flex",
	flexDirection = "column",
	gap = 6,
	minWidth = 320,
	alignItems = "stretch",
	alignContent = "stretch",
}

local ItemBtn = styled(Sx.View) {
	display = "flex",
	flexDirection = "column",
	alignItems = "flex-start",
	padding = 14,
	backgroundColor = "rgba(60,60,60,0.12)",
	borderWidth = "1px",
	borderColor = "rgba(255,255,255,0.1)",
	borderRadius = 8,
	hover = {
		backgroundColor = theme.accentSoftStrong,
		borderColor = theme.accentBorder,
	},
}

local ItemLabel = styled(Sx.Text) {
	color = "#fff",
	textAlign = "left",
	fontSize = 16,
	fontStyle = "bold",
}

local ItemDesc = styled(Sx.Text) {
	fontSize = 12,
	color = "rgba(255,255,255,0.4)",
	marginTop = 2,
}

local BackBtn = styled(Sx.Text) {
	marginTop = 12,
	padding = 10,
	fontSize = 14,
	fontStyle = "bold",
	color = "rgba(255,255,255,0.5)",
	backgroundColor = "rgba(255,255,255,0.04)",
	borderWidth = "1px",
	borderColor = "rgba(255,255,255,0.08)",
	borderRadius = 6,
	hover = { color = "#fff", backgroundColor = "rgba(255,255,255,0.08)" },
}

local Footer = styled(Sx.Text) {
	position = "absolute",
	bottom = 20,
	fontSize = 11,
	color = "rgba(255,255,255,0.3)",
}

-- ── Component ────────────────────────────────────────────────────

local MainMenu = function()
	local account, setAccount = Sx.createSignal<<AccountData | nil>>(nil)
	local pageStack, setPageStack = Sx.createSignal<<{ MenuPage }>>({})
	local currentView, setCurrentView = Sx.createSignal<<"menu" | "settings">>("menu")

	Sx.createEffect(function()
		local unsub = UiLib.onEvent("main-menu:account", function(value)
			setAccount(value)
		end)
		Sx.onCleanup(unsub)
	end)

	local goBack = function()
		local s = pageStack()
		local newS = {}
		for i = 1, #s - 1 do
			newS[i] = s[i]
		end
		setPageStack(newS)
	end

	local pushPage = function(page: MenuPage)
		local s = pageStack()
		local newS = {}
		for i = 1, #s do
			newS[i] = s[i]
		end
		newS[#newS + 1] = page
		setPageStack(newS)
	end

	-- Build page factories
	local buildSpMenu = function(): MenuPage
		return {
			title = "SINGLEPLAYER",
			items = {
				{
					label = "NFM1",
					description = "Play the original NFM1 singleplayer campaign.",
					action = function()
						UiLib.call("navigate", { page = "playNfm1" })
					end,
				},
				{
					label = "NFM2",
					description = "Play the original NFM2 singleplayer campaign.",
					action = function()
						UiLib.call("navigate", { page = "playNfm2" })
					end,
				},
				{
					label = "COMMUNITY",
					description = "Play custom experiences crafted by the community.",
					action = function()
						UiLib.call("navigate", { page = "playCommunity" })
					end,
				},
				{
					label = "FREE PLAY",
					description = "Play freely without any restrictions.",
					action = function()
						UiLib.call("navigate", { page = "play" })
					end,
				},
				{
					label = "BACK",
					description = "Return to the previous menu.",
					action = goBack,
				},
			},
		}
	end

	local buildMpMenu = function(): MenuPage
		return {
			title = "MULTIPLAYER",
			items = {
				{
					label = "COMPETITIVE",
					description = "Compete against other players via matchmaking.",
					action = function()
						UiLib.call("navigate", { page = "multiplayer" })
					end,
				},
				{
					label = "CASUAL",
					description = "Play with people in a free relaxed environment.",
					action = function()
						UiLib.call("navigate", { page = "casual" })
					end,
				},
				{
					label = "BACK",
					description = "Return to the previous menu.",
					action = goBack,
				},
			},
		}
	end

	local buildWorkshopMenu = function(): MenuPage
		return {
			title = "WORKSHOP",
			items = {
				{
					label = "MODEL EDITOR",
					description = "View and edit custom models.",
					action = function()
						UiLib.call("navigate", { page = "modelEditor" })
					end,
				},
				{
					label = "STAGE EDITOR",
					description = "Design your own stages.",
					action = function()
						UiLib.call("navigate", { page = "stageEditor" })
					end,
				},
				{
					label = "CAMPAIGN EDITOR",
					description = "Craft custom experiences.",
					action = function()
						UiLib.call("navigate", { page = "campaignEditor" })
					end,
				},
				{
					label = "BACK",
					description = "Return to the previous menu.",
					action = goBack,
				},
			},
		}
	end

	local buildTrainingMenu = function(): MenuPage
		return {
			title = "TRAINING",
			items = {
				{
					label = "TIME TRIALS",
					description = "Flex your fastest time against other people.",
					action = function()
						UiLib.call("navigate", { page = "timeTrials" })
					end,
				},
				{
					label = "CHALLENGES",
					description = "Complete challenges to sharpen your mechanical skills.",
					action = function()
						UiLib.call("navigate", { page = "challenges" })
					end,
				},
				{
					label = "GAME INSTRUCTIONS",
					description = "Read about the rules and controls of the game.",
					action = function()
						UiLib.call("navigate", { page = "gameInstructions" })
					end,
				},
				{
					label = "BACK",
					description = "Return to the previous menu.",
					action = goBack,
				},
			},
		}
	end

	local buildPlayMenu = function(): MenuPage
		return {
			title = "PLAY",
			items = {
				{
					label = "SINGLEPLAYER",
					description = "Play the original single player experiences.",
					action = function()
						pushPage(buildSpMenu())
					end,
				},
				{
					label = "MULTIPLAYER",
					description = "Play online with other players.",
					action = function()
						pushPage(buildMpMenu())
					end,
				},
				{
					label = "TRAINING",
					description = "Train your skills and learn the game mechanics.",
					action = function()
						pushPage(buildTrainingMenu())
					end,
				},
				{
					label = "BACK",
					description = "Return to the previous menu.",
					action = goBack,
				},
			},
		}
	end

	-- Main menu page
	local mainPage: MenuPage = {
		title = "NFM WORLD",
		items = {
			{
				label = "PLAY",
				description = "Play public, private matches online or play singleplayer.",
				action = function()
					pushPage(buildPlayMenu())
				end,
			},
			{
				label = "GARAGE",
				description = "Customize and inspect your vehicles in the garage.",
				action = function()
					UiLib.call("navigate", { page = "garage" })
				end,
			},
			{
				label = "WORKSHOP",
				description = "Build your own models and stages.",
				action = function()
					pushPage(buildWorkshopMenu())
				end,
			},
			{
				label = "SETTINGS",
				description = "Adjust game settings.",
				action = function()
					setCurrentView("settings")
				end,
			},
			{
				label = "CREDITS",
				description = "View game credits.",
				action = function()
					UiLib.call("navigate", { page = "credits" })
				end,
			},
			{
				label = "QUIT",
				description = "Exit the game.",
				action = function()
					UiLib.call("navigate", { page = "quit" })
				end,
			},
		},
	}

	local currentPage = Sx.createMemo(function()
		local stack = pageStack()
		return #stack > 0 and stack[#stack] or mainPage
	end)

	return (
		<Root>
			<!-- Switch for conditional views -->
			<Sx.Switch>
				<!-- Settings view -->
				<Sx.Match when={currentView() == "settings"}>
					<Settings onClose={function() setCurrentView("menu") end} />
				</Sx.Match>
				<!-- Menu view (default) -->
				<Sx.Match when={currentView() == "menu"}>
					<PageTitle name="PageTitle">
						{currentPage().title}
					</PageTitle>

					<!-- Welcome subtitle, shown only on the root page when logged in -->
					<Sx.Show when={#pageStack() == 0 and account() ~= nil and (account() :: AccountData).isLoggedIn}>
						<Subtitle name="Subtitle">
							Welcome, {(account() :: AccountData).name}
						</Subtitle>
					</Sx.Show>

					<!-- Menu items (keyed For) -->
					<Items name="Items">
						<Sx.For<<MenuItem>> each={currentPage().items}>
							{function(item: () -> MenuItem, index: number)
								return <ItemBtn
									name="ItemBtn"
									onmousedown={function(event)
										item().action()
									end}>
									<ItemLabel name="ItemLabel">
										{item().label}
									</ItemLabel>
									<ItemDesc name="ItemDesc">
										{item().description}
									</ItemDesc>
								</ItemBtn>
							end}
						</Sx.For>
					</Items>

					<!-- Footer on the root page only -->
					<Sx.Show when={function() return #pageStack() == 0 end}>
						<Footer name="Footer">{"NFM World — Lua + React UI"}</Footer>
					</Sx.Show>
				</Sx.Match>
			</Sx.Switch>
		</Root>
	)
end

return MainMenu

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorldLibrary</RootNamespace>
        <OptimizationPreference>Speed</OptimizationPreference>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
        <PublishAot>true</PublishAot>
        <NativeLib>Shared</NativeLib>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exclude emitted source-generator files from implicit *.cs glob to prevent double compilation -->
        <Compile Remove="Generated/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="ENet-CSharp" Version="2.4.8" />
        <PackageReference Include="Lua.NET" Version="6.0.1" />
        <PackageReference Include="LuzFaltex.Core.Collections" Version="0.1.0" />
        <PackageReference Include="MessagePack" Version="3.1.8" />
        <PackageReference Include="MessagePack.Experimental" Version="3.1.8" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.5.26302.115" />
        <None Include="data\**\*" CopyToOutputDirectory="Always" />
        <None Remove="data\.git\**" CopyToOutputDirectory="Never" />
        <None Remove="data\.git" CopyToOutputDirectory="Never" />
        <None Include="src\**\*" CopyToOutputDirectory="Always" />
        <None Remove="src\data\.git\**" CopyToOutputDirectory="Never" />
        <None Remove="src\data\.git" CopyToOutputDirectory="Never" />
        <PackageReference Include="ZLogger" Version="2.5.10" />
        <ProjectReference Include="..\HoleyDiver\HoleyDiver.csproj" />
        <ProjectReference Include="..\MemoryPack\src\MemoryPack\MemoryPack.csproj" />
        <ProjectReference Include="..\MemoryPack\src\MemoryPack.Generator\MemoryPack.Generator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\NFMWorld.CrashReporter\NFMWorld.CrashReporter.csproj" />
        <ProjectReference Include="..\NFMWorld.DriverInterface\NFMWorld.DriverInterface.csproj" />
        <ProjectReference Include="..\NFMWorld.OpcodeSourceGen\NFMWorld.OpcodeSourceGen.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\NFMWorld.ClientOnlyAnalyzer\NFMWorld.ClientOnlyAnalyzer.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\NFMWorld.PhysicsFS\NFMWorld.PhysicsFS.csproj" />
        <ProjectReference Include="..\NFMWorld.Sentry\NFMWorld.Sentry.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FixedMathSharp\src\FixedMathSharp\FixedMathSharp.csproj" />
      <ProjectReference Include="..\FNA.Math\FNA.Math.csproj" />
      <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.MessagePack\Maxine.Extensions.MessagePack.csproj" />
      <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions\Maxine.Extensions.csproj" />
      <ProjectReference Include="..\Maxine.Extensions\RayTech.RayLog.MEL\RayTech.RayLog.MEL.csproj" />
      <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.Mathematics\Maxine.Extensions.Mathematics.csproj" />
      <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.UnionGen\Maxine.Extensions.UnionGen.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
      <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.UnionGen.Base\Maxine.Extensions.UnionGen.Base.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="data\" />
      <Folder Include="Gamemodes\Default\" />
      <Folder Include="Mad\Multiplayer\Packets\Lobby\" />
    </ItemGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptOutputDirectory" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptImportExtension" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptConvertPropertyName" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptEnableNullableTypes" />
    </ItemGroup>
    <PropertyGroup>
        <MemoryPackGenerator_TypeScriptOutputDirectory>$(MSBuildProjectDirectory)\..\nfm-world\data\html\src\shared\memorypack</MemoryPackGenerator_TypeScriptOutputDirectory>
        <MemoryPackGenerator_TypeScriptEnableNullableTypes>true</MemoryPackGenerator_TypeScriptEnableNullableTypes>
    </PropertyGroup>

</Project>

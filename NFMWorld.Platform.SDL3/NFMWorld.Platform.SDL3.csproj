<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorld.Platform.SDL3</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- FNA's own vendored SDL3-CS (not the unrelated NuGet package of the same name) -
             kept for its marshaling style, matching what FNA's SDL3_FNAPlatform.cs itself uses. -->
        <ProjectReference Include="..\FNA\lib\SDL3-CS\SDL3\SDL3.Core.csproj" />
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>TightPack</RootNamespace>
        <!-- The whole point of this library is that it never needs the unsafe keyword. -->
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <NoWarn>$(NoWarn);CA2255</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <None Update="Formatters\InlineArrayFormatters.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>InlineArrayFormatters.cs</LastGenOutput>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Formatters\InlineArrayFormatters.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>InlineArrayFormatters.tt</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>

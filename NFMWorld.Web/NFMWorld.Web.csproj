<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <WasmShellMonoRuntimeExecutionMode>InterpreterAndAOT</WasmShellMonoRuntimeExecutionMode>
        <WasmShellIndexHtmlPath>index.html</WasmShellIndexHtmlPath>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DefineConstants></DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <LinkerDescriptor Include="LinkerConfig.xml" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="FAudio.a" />
        <Content Include="FNA3D.a" />
        <Content Include="libmojoshader.a" />
        <Content Include="SDL2.a" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Uno.Wasm.Bootstrap" Version="10.1.0-dev.24" />
        <PackageReference Include="Uno.Wasm.Bootstrap.DevServer" Version="10.1.0-dev.24" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\nfm-world\NFMWorld.csproj" />
    </ItemGroup>

    <ItemGroup>
        <WasmShellExtraEmccFlags Include="-s MIN_WEBGL_VERSION=2 -s MAX_WEBGL_VERSION=2 --preload-file $([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)/../nfm-world'))/data@data" />
    </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorld.Graphics.D3D11.Smoke</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
        <ProjectReference Include="..\NFMWorld.Graphics.D3D11\NFMWorld.Graphics.D3D11.csproj" />
        <ProjectReference Include="..\NFMWorld.Shaders.Abstraction\NFMWorld.Shaders.Abstraction.csproj" />
        <!-- The game's own text renderer. This is the only smoke context with working screen space
             derivatives - the GL one runs headless ANGLE, where ddx/ddy come back 0 and every shape
             draws hard edged - so it is the only place a glyph's AA band renders at all. -->
        <ProjectReference Include="..\Apos.Shapes\Source\Apos.Shapes.NFMW.csproj" />
    </ItemGroup>

    <!-- The game's own font, at the size the debug counter draws it. -->
    <ItemGroup>
        <None Include="..\nfm-world\data\fonts\NotoSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <!-- The real generated bundles, produced here by the same build step the game uses. That matters
         more here than it does in the GL smoke test: D3D11's input layout is validated by
         CreateInputLayout against the compiled shader's own signature, so the HLSL has to be the
         compiler's actual output rather than a hand-written stand-in. It is also the second
         independent consumer of the task, which is what would catch a task that only works from the
         directory it was developed in. -->
    <PropertyGroup>
        <NFMWorldShadersDirectory>$(MSBuildProjectDirectory)\..\nfm-world\data\shaders</NFMWorldShadersDirectory>
    </PropertyGroup>

    <Import Project="..\NFMWorld.ShaderCompiler.Task\NFMWorld.ShaderCompiler.targets" />

</Project>

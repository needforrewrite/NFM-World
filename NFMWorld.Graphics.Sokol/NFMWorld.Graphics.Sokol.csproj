<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Every sg_* call takes an unmanaged pointer (sg_range over pinned data, desc structs
             built on the stack, fixed byte arrays for shader bytecode), so unsafe is not optional. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorld.Graphics.Sokol</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <!-- Raw D3D11/DXGI bindings, for SokolD3D11Platform: sokol_gfx refuses to create a device or
           a swapchain (see ISokolPlatform), so this backend does, against SDL's window. Pinned to
           2.22.0 to match the Silk.NET.OpenGL the game already references. Silk.NET is used only
           for its function-pointer tables here - no Silk window is ever created. -->
      <PackageReference Include="Silk.NET.Direct3D11" Version="2.22.0" />
      <PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
      <ProjectReference Include="..\SharpSokol\src\SharpSokol\SharpSokol.csproj" />
    </ItemGroup>

    <!--
         The native libraries this backend P/Invokes, deployed from here rather than by every
         consumer. They live here because this is the assembly that has the dependency: a consumer
         referencing this project wants sokol_gfx to work, and having each one remember to copy a DLL
         out of a sibling project's native/ directory is the kind of thing that works until it
         doesn't.

         **One subdirectory per backend, all containing a file called sokol.dll.** sokol selects its
         backend with a compile-time symbol, one per translation unit, so each backend is a separate
         build of the same library (see .github/workflows/build-native.yml) - but every SharpSokol
         P/Invoke names the plain library "sokol", and that submodule is not ours to edit. So the
         *directory* carries the distinction and SokolBackendSelection's resolver picks the one that
         matches the sokol-backend launch argument. The file name inside is always sokol.dll, which
         keeps the Link target (and therefore the DLL search path) uniform.

         The directory name here must match SokolBackendSelection.NativeDirectory.

         Only win-x64 is vendored - see native/. A second RID means a second pair of items, and the
         dylib/so variants would need the resolver's file-extension logic widened too.
      -->
    <ItemGroup>
      <None Include="native\win-x64\sokol.dll" Link="sokol\d3d11\sokol.dll" CopyToOutputDirectory="PreserveNewest" />
      <None Include="native\win-x64\glcore\sokol_win64_glcore.dll" Link="sokol\glcore\sokol.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>

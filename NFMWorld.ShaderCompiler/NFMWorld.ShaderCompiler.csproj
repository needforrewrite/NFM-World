<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Exe only so that Program.cs - the hand-debugging host over the library - keeps working
             with `dotnet run`. The build itself uses the library: the task project references this
             one and gets NFMWorld.ShaderCompiler.dll out of it exactly as it would from a library,
             since a ProjectReference carries the assembly and not the apphost. -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorld.ShaderCompiler</RootNamespace>
        <!-- The MSBuild task loads this assembly into MSBuild's own process, where a deps.json is
             not consulted for a plugin style load: the task project therefore needs this library
             and every Silk.NET assembly it pulls in sitting next to the task DLL, not merely
             recorded as a dependency. Without it the task builds and then fails at load time with
             a FileNotFoundException the moment it reaches shaderc. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!-- Silk.NET's bindings use trimming-unsafe reflection internally; the analyzer's advice
             does not apply to a build-time tool that is never trimmed or published. Same setting,
             same reason, as the POC project this was promoted from. -->
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0"/>
        <!-- The SPIR-V -> WGSL translator: taint, a packaged build of Dawn's Tint, bound through
             TaintSharp. A library rather than the tint CLI it replaced, which is what makes macOS
             work - the CLI package's osx-arm64 binary was built without Tint's SPIR-V reader. The
             natives are a plain `DllImport("taint")` asset, so they are copied flat beside this
             assembly for WgslCompiler's resolver instead of through NuGet's runtimes/ layout,
             which under TaskHostFactory is not probed. Only win-x64, linux-x64 and osx-arm64 are
             packaged; WgslCompiler.Available reports that rather than failing the build. -->
        <PackageReference Include="TaintSharp" Version="1.0.0" GeneratePathProperty="true" ExcludeAssets="native" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(PkgTaintSharp)\runtimes\$(NETCoreSdkRuntimeIdentifier)\native\*"
              Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorld.Graphics.OpenGL.Smoke</RootNamespace>
        <!-- ANGLE is a native library, so the test process must match it. The bindings' native
             package ships every RID, but the ANGLE this backend is verified against is the x64 one,
             so an x86 test host would exercise a different build than the rest of the project. -->
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
        <ProjectReference Include="..\NFMWorld.Graphics.OpenGL\NFMWorld.Graphics.OpenGL.csproj" />
        <ProjectReference Include="..\NFMWorld.Shaders.Abstraction\NFMWorld.Shaders.Abstraction.csproj" />
    </ItemGroup>

    <!-- The real generated bundles, exactly as the shader compiler emitted them - the same pattern
         NFMWorld.Graphics.Sokol.Smoke's BundleCheck uses, so the ES GLSL this backend compiles is
         the one the compiler actually produced rather than a hand-written stand-in.
         That matters most for the one thing no hand-written shader could test: whether the ES
         combined samplers are named after the textures the reflection reports, which is the
         NameCombinedSamplers fix in SpirvCrossReflector. -->
    <ItemGroup>
        <Compile Include="..\scratch\ShaderPoc\generated\*.g.cs" LinkBase="Generated" />
    </ItemGroup>

</Project>

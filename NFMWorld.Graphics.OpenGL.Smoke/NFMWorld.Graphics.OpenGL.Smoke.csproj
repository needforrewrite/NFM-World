<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorld.Graphics.OpenGL.Smoke</RootNamespace>
        <!-- ANGLE is a native library, so the test process must match it. The bindings' native
             package ships every RID, but the ANGLE this backend is verified against is the x64 one,
             so an x86 test host would exercise a different build than the rest of the project. -->
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
        <ProjectReference Include="..\NFMWorld.Graphics.OpenGL\NFMWorld.Graphics.OpenGL.csproj" />
        <ProjectReference Include="..\NFMWorld.Shaders.Abstraction\NFMWorld.Shaders.Abstraction.csproj" />
        <!-- The one shader whose compile dominates startup, measured on the same path the game
             takes rather than on a hand-written stand-in. -->
        <ProjectReference Include="..\Apos.Shapes\Source\Apos.Shapes.NFMW.csproj" />
    </ItemGroup>

    <!-- The real generated bundles, produced here by the same build step the game uses, so the ES
         GLSL this backend compiles is the one the compiler actually produced rather than a
         hand-written stand-in. That matters most for the one thing no hand-written shader could
         test: whether the ES combined samplers are named after the textures the reflection
         reports, which is the NameCombinedSamplers fix in SpirvCrossReflector.

         Run here rather than referencing nfm-world's copy of the output, for two reasons. The
         bundles are `internal` and namespaced, so a file-level link from another project's obj/
         would work only by accident of them being compiled into this assembly anyway; and running
         the compiler makes this project a *second* independent consumer of the task, which is what
         would catch a task that only works from the directory it was developed in. The sources are
         nfm-world's - duplicating data/shaders here would let the two drift. -->
    <PropertyGroup>
        <NFMWorldShadersDirectory>$(MSBuildProjectDirectory)\..\nfm-world\data\shaders</NFMWorldShadersDirectory>
    </PropertyGroup>

    <Import Project="..\NFMWorld.ShaderCompiler.Task\NFMWorld.ShaderCompiler.targets" />

</Project>

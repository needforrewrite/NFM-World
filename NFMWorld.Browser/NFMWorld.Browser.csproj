<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <!-- The browser head. Mirrors NFMWorld/NFMWorld.csproj (the desktop exe), with the
         wasm runtime and the browser equivalents of the SDL platform layer.

         The SDK has to be Microsoft.NET.Sdk.WebAssembly rather than Microsoft.NET.Sdk: the
         plain one leaves SelfContained/UseMonoRuntime unset for browser-wasm, so no runtime pack
         resolves at all, and it does not generate the _framework bundle. -->
    <!-- The browser head is the only project on net12.0, and it is the only one that needs the
         nightly SDK. CoreCLR's wasm runtime is what gives this build ReadyToRun images and a
         collectible AssemblyLoadContext; the Mono runtime gave neither. Everything else stays on
         net11.0 and builds with the stable SDK - a net12.0 project may reference net11.0 ones. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net12.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>NFMWorld.Browser</RootNamespace>
        <DefineConstants>ANGLE;$(DefineConstants)</DefineConstants>

        <WasmBuildNative>true</WasmBuildNative>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- CoreCLR only runs with wasm exception handling, and it is also the only model the
             toolchain offers here: -fwasm-exceptions at link, so every native archive must be
             built with it too. Mixing the two is not a link error: the module loads and then
             aborts the first time C++ throws, with no message. libopenmpt is the one archive that
             throws, and native/build-libopenmpt.sh builds it to match. -->
        <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>

        <!-- CoreCLR instead of Mono. Two things come with it: a collectible AssemblyLoadContext,
             so a gamemode plugin actually unloads (Mono wasm has none), and ReadyToRun, which the
             Mono runtime has no support for here - the GA SDK rejects the property outright with
             NETSDK1095. Composite rather than per-assembly: a per-assembly image pays a
             cross-assembly call through a stub costlier than the interpreted call it replaces. -->
        <UseMonoRuntime>false</UseMonoRuntime>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishReadyToRunComposite>true</PublishReadyToRunComposite>

        <!-- The workload's Cache pack, not a directory of our own: emscripten resolves system
             libraries with os.path.relpath against the SDK tree, which throws "path is on mount
             W:, start on mount C:" when the cache lives on another drive, and the pack's copy is
             complete and prebuilt (its emscripten/cache/sysroot_install.stamp included). The SDK
             freezes the cache only while it is this one, which is what makes it read-only. -->
        <WasmCachePath>$(EmscriptenCacheSdkCacheDir)</WasmCachePath>

        <!-- Native debug symbols: the emscripten stack in a trap log is otherwise a list of
             indices, and a CoreCLR relink regenerates dotnet.native.wasm's symbol map with the
             module. -->
        <WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>

        <!-- The game is trimmed; the plugin API is rooted by the linker descriptors at the end
             of this file. It is also the usual source of "worked in Debug" reflection failures,
             which is why the first playable milestone is checked with trimming on rather than
             deferred to the end. -->
        <PublishTrimmed>true</PublishTrimmed>

        <!-- Trimming switches System.Text.Json's reflection resolver off by default, and that is
             the path AccountManager's PostAsJsonAsync/ReadFromJsonAsync calls take: the archive's
             login and asset DTOs have no JsonSerializerContext. Off, the first call throws
             InvalidOperationException - which is what signing in to the web build does. Same
             switch as NFMWorld/NFMWorld.csproj; keep the two in step. -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

        <!-- HoleyDiver and NFMWorld.CrashReporter are OutputType=Exe (they double as tools), and a
             self-contained app may not reference a non-self-contained exe (NETSDK1150). The SDK's
             own escape hatch: it lets such references through because the head is the app and the
             referenced project is only a library to it. Both are consumed purely as assemblies
             here - neither's Main is ever called. -->
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>

        <!-- WorldGame.cs carries the desktop Main as well as the game class; the browser head
             supplies its own entry point, so the desktop one is compiled out here. -->
        <StartupObject>NFMWorld.Browser.Program</StartupObject>
    </PropertyGroup>

    <!-- Marks the build as a browser one for projects that cannot see RuntimeIdentifier: the SDK
         strips it from every library reference, so a project three hops down (Lua, which picks its
         compiler features from it) never learns the target. This is passed on the command line
         because a property set here does not reach referenced projects either. -->
    <Target Name="_RequireBrowserMarker" BeforeTargets="PrepareForBuild">
        <Error Condition="'$(NfmwBrowser)' != 'true'"
               Text="Publish with -p:NfmwBrowser=true. Without it the game project references the desktop ImGui binding and compiles without WEB_AUDIO, which does not link here." />
    </Target>

    <!-- Link sizes are CoreCLR SDK properties, not raw emscripten flags: the CoreCLR link step
         already emits -sINITIAL_MEMORY / -sMAXIMUM_MEMORY / -sALLOW_MEMORY_GROWTH from these, and
         a second copy in EmccFlags would be one more place for them to disagree. 2 GB maximum is
         the SDK default; only the initial heap is raised. -->
    <PropertyGroup>
        <WasmInitialHeapSize>134217728</WasmInitialHeapSize>
        <EmccFlags>
            -sFULL_ES3
            -sMIN_WEBGL_VERSION=2
            -sMAX_WEBGL_VERSION=2
            -sGL_ENABLE_GET_PROC_ADDRESS=1
        </EmccFlags>
    </PropertyGroup>

    <!-- emdawnwebgpu's JS half. The four libraries are link inputs, not compilable sources, so they
         arrive as js-library options; the order matters (library_webgpu.js depends on the three
         generated tables and must come last), and it is the package's own port.py order. The path
         is restated here rather than read from NFMWorld.Platform.WebGPU: a property does not flow
         across a ProjectReference, so that project publishes it as a plain property for exactly
         this, and a copy is what both heads can see. -->
    <PropertyGroup>
        <WebGpuShimDir>$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGPU\obj\wgpu-shim\</WebGpuShimDir>
        <!-- Forward slashes, not the native separators EmccExtraLDFlags otherwise tolerates: emcc
             hands its argument to node for the JS preprocessor, which reads a backslash as an escape
             and drops it - the path arrived as "W:projectsNFM-World..." and the link failed with a
             JS compiler internal error naming a file that never existed. -->
        <WebGpuJsLibraryDir>$([System.String]::Copy('$(WebGpuShimDir)emdawnwebgpu\webgpu\src\').Replace('\','/'))</WebGpuJsLibraryDir>
    </PropertyGroup>

    <!-- What the game P/Invokes and this head must therefore export from the module. The
         browser P/Invoke table resolves against the module itself (the game's ImportResolver
         answers every browser import with GetMainProgramHandle), so these have to be real
         exports - and they are raw linker flags rather than EmccExportedFunction items because
         emscripten filters exports its own JS libraries also define (SDL_Init is one). -->
    <PropertyGroup>
        <!-- The .NET runtime is C, so the SDK's link does not pull in libc++. libopenmpt is C++
             and throws on bad input; without the C++ runtime the SDK's allow-undefined flag turns
             __cxa_throw into an empty stub, so the throw reaches std::terminate and the whole
             module exits with no message. The runtime and the exception personality are only
             linked when C++ is detected, which an archive does not trigger, so name them here. -->
        <EmccExtraLDFlags>
            -lc++ -lc++abi
            --js-library=$(WebGpuJsLibraryDir)library_webgpu_enum_tables.js
            --js-library=$(WebGpuJsLibraryDir)library_webgpu_generated_struct_info.js
            --js-library=$(WebGpuJsLibraryDir)library_webgpu_generated_sig_info.js
            --js-library=$(WebGpuJsLibraryDir)library_webgpu.js
            -Wl,--export=SDL_CreateWindow -Wl,--export=SDL_DestroyWindow -Wl,--export=SDL_EGL_SetAttributeCallbacks
            -Wl,--export=SDL_GL_CreateContext -Wl,--export=SDL_GL_DestroyContext -Wl,--export=SDL_GL_GetAttribute
            -Wl,--export=SDL_GL_GetProcAddress -Wl,--export=SDL_GL_LoadLibrary -Wl,--export=SDL_GL_SetAttribute
            -Wl,--export=SDL_GL_SetSwapInterval -Wl,--export=SDL_GL_SwapWindow -Wl,--export=SDL_GetError
            -Wl,--export=SDL_GetFullscreenDisplayModes -Wl,--export=SDL_GetKeyboardState -Wl,--export=SDL_GetMouseState
            -Wl,--export=SDL_GetPointerProperty -Wl,--export=SDL_GetPrimaryDisplay -Wl,--export=SDL_GetWindowFlags
            -Wl,--export=SDL_GetWindowProperties -Wl,--export=SDL_Init -Wl,--export=SDL_PollEvent
            -Wl,--export=SDL_Quit -Wl,--export=SDL_SetHint -Wl,--export=SDL_SetWindowBordered
            -Wl,--export=SDL_SetWindowFullscreen -Wl,--export=SDL_SetWindowSize -Wl,--export=SDL_StartTextInput
            -Wl,--export=SDL_free -Wl,--export=SDL_malloc
            <!-- The WebGL shim's entry points, resolved through the same table as SDL.
                 Generated from obj/**/pinvoke-table.h; regenerate when an entry point is added,
                 or the link fails naming a symbol the code calls. -->
            -Wl,--export=nfmw_context_create -Wl,--export=nfmw_context_resize -Wl,--export=nfmw_context_swap
            -Wl,--export=nfmw_glActiveTexture -Wl,--export=nfmw_glAttachShader -Wl,--export=nfmw_glBindBuffer
            -Wl,--export=nfmw_glBindBufferBase -Wl,--export=nfmw_glBindFramebuffer -Wl,--export=nfmw_glBindSampler
            -Wl,--export=nfmw_glBindTexture -Wl,--export=nfmw_glBindVertexArray -Wl,--export=nfmw_glBlendEquationSeparate
            -Wl,--export=nfmw_glBlendFunc -Wl,--export=nfmw_glBlendFuncSeparate -Wl,--export=nfmw_glBufferData
            -Wl,--export=nfmw_glBufferSubData -Wl,--export=nfmw_glCheckFramebufferStatus -Wl,--export=nfmw_glClear
            -Wl,--export=nfmw_glClearColor -Wl,--export=nfmw_glClearDepthf -Wl,--export=nfmw_glClearStencil
            -Wl,--export=nfmw_glColorMask -Wl,--export=nfmw_glCompileShader -Wl,--export=nfmw_glCreateProgram
            -Wl,--export=nfmw_glCreateShader -Wl,--export=nfmw_glCullFace -Wl,--export=nfmw_glDeleteBuffers
            -Wl,--export=nfmw_glDeleteFramebuffers -Wl,--export=nfmw_glDeleteProgram -Wl,--export=nfmw_glDeleteSamplers
            -Wl,--export=nfmw_glDeleteShader -Wl,--export=nfmw_glDeleteTextures -Wl,--export=nfmw_glDeleteVertexArrays
            -Wl,--export=nfmw_glDepthFunc -Wl,--export=nfmw_glDepthMask -Wl,--export=nfmw_glDepthRangef
            -Wl,--export=nfmw_glDisable -Wl,--export=nfmw_glDisableVertexAttribArray -Wl,--export=nfmw_glDrawArrays
            -Wl,--export=nfmw_glDrawArraysInstanced -Wl,--export=nfmw_glDrawBuffers -Wl,--export=nfmw_glDrawElements
            -Wl,--export=nfmw_glDrawElementsInstanced -Wl,--export=nfmw_glEnable -Wl,--export=nfmw_glEnableVertexAttribArray
            -Wl,--export=nfmw_glFinish -Wl,--export=nfmw_glFlush -Wl,--export=nfmw_glFramebufferTexture2D
            -Wl,--export=nfmw_glFrontFace -Wl,--export=nfmw_glGenBuffers -Wl,--export=nfmw_glGenFramebuffers
            -Wl,--export=nfmw_glGenSamplers -Wl,--export=nfmw_glGenTextures -Wl,--export=nfmw_glGenVertexArrays
            -Wl,--export=nfmw_glGenerateMipmap -Wl,--export=nfmw_glGetActiveAttrib -Wl,--export=nfmw_glGetActiveUniform
            -Wl,--export=nfmw_glGetActiveUniformBlockiv -Wl,--export=nfmw_glGetActiveUniformsiv -Wl,--export=nfmw_glGetAttribLocation
            -Wl,--export=nfmw_glGetError -Wl,--export=nfmw_glGetIntegerv -Wl,--export=nfmw_glGetProgramInfoLog
            -Wl,--export=nfmw_glGetProgramiv -Wl,--export=nfmw_glGetShaderInfoLog -Wl,--export=nfmw_glGetShaderiv
            -Wl,--export=nfmw_glGetString -Wl,--export=nfmw_glGetStringi -Wl,--export=nfmw_glGetUniformBlockIndex -Wl,--export=nfmw_glGetUniformLocation
            -Wl,--export=nfmw_glLinkProgram -Wl,--export=nfmw_glPixelStorei -Wl,--export=nfmw_glPolygonOffset
            -Wl,--export=nfmw_glReadBuffer -Wl,--export=nfmw_glReadPixels -Wl,--export=nfmw_glSamplerParameterf
            -Wl,--export=nfmw_glSamplerParameteri -Wl,--export=nfmw_glScissor -Wl,--export=nfmw_glShaderSource
            -Wl,--export=nfmw_glStencilFunc -Wl,--export=nfmw_glStencilFuncSeparate -Wl,--export=nfmw_glStencilMask
            -Wl,--export=nfmw_glStencilOp -Wl,--export=nfmw_glStencilOpSeparate -Wl,--export=nfmw_glTexImage2D
            -Wl,--export=nfmw_glTexParameterf -Wl,--export=nfmw_glTexParameteri -Wl,--export=nfmw_glTexSubImage2D
            -Wl,--export=nfmw_glUniform1 -Wl,--export=nfmw_glUniform1f -Wl,--export=nfmw_glUniform1fv
            -Wl,--export=nfmw_glUniform1i -Wl,--export=nfmw_glUniform1iv -Wl,--export=nfmw_glUniform1ui
            -Wl,--export=nfmw_glUniform1uiv -Wl,--export=nfmw_glUniformBlockBinding -Wl,--export=nfmw_glUseProgram
            -Wl,--export=nfmw_glVertexAttribDivisor -Wl,--export=nfmw_glVertexAttribIPointer -Wl,--export=nfmw_glVertexAttribPointer
            -Wl,--export=nfmw_glViewport 
            <!-- emdawnwebgpu's forwarders, one per symbol in
                 NFMWorld.Platform.WebGPU/native/wgpu_shim.c. Same rule as the shim above: an
                 export is the only way the P/Invoke table can see them, and a missing one is a
                 link error rather than a run-time resolution failure, which is why all of them
                 are listed even though the WebGPU path only runs when the page has a device. -->
            -Wl,--export=nfmw_AdapterGetInfo -Wl,--export=nfmw_AdapterGetLimits -Wl,--export=nfmw_AdapterHasFeature
            -Wl,--export=nfmw_AdapterInfoFreeMembers -Wl,--export=nfmw_AdapterRelease
            -Wl,--export=nfmw_BindGroupLayoutRelease -Wl,--export=nfmw_BindGroupRelease -Wl,--export=nfmw_BufferDestroy
            -Wl,--export=nfmw_BufferGetConstMappedRange -Wl,--export=nfmw_BufferRelease -Wl,--export=nfmw_BufferUnmap
            -Wl,--export=nfmw_CommandBufferRelease -Wl,--export=nfmw_CommandEncoderBeginRenderPass
            -Wl,--export=nfmw_CommandEncoderCopyBufferToBuffer -Wl,--export=nfmw_CommandEncoderCopyBufferToTexture
            -Wl,--export=nfmw_CommandEncoderCopyTextureToBuffer -Wl,--export=nfmw_CommandEncoderFinish
            -Wl,--export=nfmw_CommandEncoderRelease -Wl,--export=nfmw_CreateInstance
            -Wl,--export=nfmw_DeviceCreateBindGroup -Wl,--export=nfmw_DeviceCreateBindGroupLayout
            -Wl,--export=nfmw_DeviceCreateBuffer -Wl,--export=nfmw_DeviceCreateCommandEncoder
            -Wl,--export=nfmw_DeviceCreatePipelineLayout -Wl,--export=nfmw_DeviceCreateRenderPipeline
            -Wl,--export=nfmw_DeviceCreateSampler -Wl,--export=nfmw_DeviceCreateShaderModule
            -Wl,--export=nfmw_DeviceCreateTexture -Wl,--export=nfmw_DeviceGetAdapterInfo
            -Wl,--export=nfmw_DeviceGetLimits -Wl,--export=nfmw_DeviceGetQueue -Wl,--export=nfmw_DeviceHasFeature
            -Wl,--export=nfmw_DeviceRelease -Wl,--export=nfmw_InstanceCreateSurface
            -Wl,--export=nfmw_InstanceProcessEvents -Wl,--export=nfmw_InstanceRelease
            -Wl,--export=nfmw_PipelineLayoutRelease -Wl,--export=nfmw_QueueRelease -Wl,--export=nfmw_QueueSubmit
            -Wl,--export=nfmw_QueueWriteBuffer -Wl,--export=nfmw_QueueWriteTexture
            -Wl,--export=nfmw_RenderPassEncoderDraw -Wl,--export=nfmw_RenderPassEncoderDrawIndexed
            -Wl,--export=nfmw_RenderPassEncoderEnd -Wl,--export=nfmw_RenderPassEncoderRelease
            -Wl,--export=nfmw_RenderPassEncoderSetBindGroup -Wl,--export=nfmw_RenderPassEncoderSetIndexBuffer
            -Wl,--export=nfmw_RenderPassEncoderSetPipeline -Wl,--export=nfmw_RenderPassEncoderSetScissorRect
            -Wl,--export=nfmw_RenderPassEncoderSetVertexBuffer -Wl,--export=nfmw_RenderPassEncoderSetViewport
            -Wl,--export=nfmw_RenderPipelineRelease -Wl,--export=nfmw_SamplerRelease
            -Wl,--export=nfmw_ShaderModuleRelease -Wl,--export=nfmw_SurfaceCapabilitiesFreeMembers
            -Wl,--export=nfmw_SurfaceConfigure -Wl,--export=nfmw_SurfaceGetCapabilities
            -Wl,--export=nfmw_SurfaceGetCurrentTexture -Wl,--export=nfmw_SurfacePresent -Wl,--export=nfmw_SurfaceRelease
            -Wl,--export=nfmw_TextureCreateView -Wl,--export=nfmw_TextureDestroy -Wl,--export=nfmw_TextureRelease
            -Wl,--export=nfmw_TextureViewRelease -Wl,--export=nfmw_emscripten_webgpu_get_device
        </EmccExtraLDFlags>
    </PropertyGroup>

    <!-- No Microsoft.NET.Sdk.WebAssembly.Pack reference: the nightly SDK ships that SDK in the
         dotnet/sdk directory, so the pin the GA-era build needed (the 11.0.0-rc.3 package, whose
         Mono-era props the 12.0 workload manifest would shadow anyway) is gone. -->

    <!-- The two native archives are built by the platform projects, but they have to be declared
         here: NativeFileReference is read by whichever project does the link, and items from a
         ProjectReference do not arrive in this project's item list. Paths are the ones those
         targets produce (see each project's build target). -->
    <ItemGroup>
        <NativeFileReference Include="$(MSBuildThisFileDirectory)..\NFMWorld.Platform.SDL3.Browser\obj\sdl3\SDL3.a" />
        <NativeFileReference Include="$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGL\obj\webgl-shim\webgl_shim.a" />
        <NativeFileReference Include="$(MSBuildThisFileDirectory)..\NFMWorld.Browser\obj\cimgui\cimgui.a" />
        <!-- emdawnwebgpu plus wgpu_shim.c. Built to LLVM bitcode like the others, so the .NET
             native build's LTO keeps its symbols; see NFMWorld.Platform.WebGPU/native. -->
        <NativeFileReference Include="$(WebGpuShimDir)wgpu_native.a" />
        <!-- libopenmpt, built for wasm with the workload's emscripten. Not checked in: the build
             needs make and a POSIX toolchain, so web.yml builds it in a Linux job and hands the
             archive to the Windows one. Locally, run
             NFMWorld.Platform.WebGL/native/build-libopenmpt.sh into this directory. -->
        <NativeFileReference Include="$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGL\native\libopenmpt.a"
                             Condition="Exists('$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGL\native\libopenmpt.a')" />
    </ItemGroup>

    <!-- The two native archives the link needs, built here rather than through their own
         ProjectReference - see the note on those references for why a reference cannot reach the
         targets that produce them. RID passed explicitly so their conditions see browser-wasm;
         DependsOnTargets is not an option for the same reason. Early enough that the SDK's own
         NativeFileReference validation (in _PrepareForBrowserWasmBuildNative, which
         PrepareForWasmBuildNativeDependsOn runs) finds the archives on disk. -->
    <Target Name="BuildNativeArchives"
            BeforeTargets="PrepareForBuild;_WasmWriteRspForCompilingNativeSourceFiles"
            Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\NFMWorld.Platform.SDL3.Browser\NFMWorld.Platform.SDL3.Browser.csproj"
                 Targets="BuildSDL3"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=browser-wasm" />
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGL\NFMWorld.Platform.WebGL.csproj"
                 Targets="BuildWebGlShim"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=browser-wasm" />
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGPU\NFMWorld.Platform.WebGPU.csproj"
                 Targets="BuildWebGpuShim"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=browser-wasm" />
    </Target>

    <!-- The archive is a build input that is no longer checked in, so a missing one would
         otherwise surface only as a link failure naming a symbol, or worse as a P/Invoke that
         resolves to nothing at run time. -->
    <Target Name="_RequireLibOpenmpt" BeforeTargets="PrepareForBuild" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
        <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGL\native\libopenmpt.a')"
               Text="libopenmpt.a is missing. Run NFMWorld.Platform.WebGL/native/build-libopenmpt.sh NFMWorld.Platform.WebGL/native (or use the web.yml workflow, which builds it)." />
    </Target>

    <!-- cimgui, built the same way as the WebGL shim: the workload's own emscripten, -emit-llvm,
         archived under the name the [DllImport("cimgui")] strings use. Runs before the native
         build, which is what links the archive. No Inputs/Outputs, for the same reason as the
         shim's target - MSBuild would skip the refresh steps along with the compile. -->
    <Target Name="BuildCImgui"
            Condition="'$(RuntimeIdentifier)' == 'browser-wasm'"
            BeforeTargets="PrepareForBuild;_WasmWriteRspForCompilingNativeSourceFiles"
            DependsOnTargets="_CoreCLRSetupEmscripten">
        <PropertyGroup>
            <CImguiDir>$(BaseIntermediateOutputPath)cimgui</CImguiDir>
            <!-- Frozen only when EM_CACHE is the SDK's own (read-only) cache dir. The SDK's
                 .emscripten defaults FROZEN_CACHE to True, so a fresh cache elsewhere fails every
                 compile with "FROZEN_CACHE is set, but cache file is missing". Not taken from
                 @(EmscriptenEnvVars): those items are made by _PrepareForBrowserWasmBuildNative,
                 which errors on the archive this target exists to build. -->
            <_CImguiFrozenCache Condition="'$(WasmCachePath)' == '$(EmscriptenCacheSdkCacheDir)'">1</_CImguiFrozenCache>
            <_CImguiFrozenCache Condition="'$(WasmCachePath)' != '$(EmscriptenCacheSdkCacheDir)'">0</_CImguiFrozenCache>
        </PropertyGroup>
        <Exec Command="&quot;$(EmscriptenPythonToolsPath)python.exe&quot; &quot;$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGL\build_cimgui.py&quot; &quot;$(CImguiDir)\cimgui.a&quot; &quot;$(CImguiDir)&quot; &quot;$(MSBuildThisFileDirectory)..\NFMWorld.Platform.WebGL\ext\cimgui&quot;"
              EnvironmentVariables="EMSDK=$(EmscriptenSdkToolsPath);EMSDK_PYTHON=$(EmscriptenPythonToolsPath)python.exe;PYTHONHOME=;PYTHONPATH=$(EmscriptenSdkToolsPath)python;DOTNET_EMSCRIPTEN_LLVM_ROOT=$(EmscriptenSdkToolsPath)bin;DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(EmscriptenSdkToolsPath);DOTNET_EMSCRIPTEN_NODE_JS=$(EmscriptenNodeToolsPath)bin/node.exe;EM_CACHE=$(WasmCachePath);EM_FROZEN_CACHE=$(_CImguiFrozenCache)"
              StandardOutputImportance="normal" />
    </Target>

    <!-- The two data archives, built from the game's tree rather than checked in: the boot set the
         page fetches up front, and the music it fetches per track. Runs on every build because the
         tree is the input and there is no cheaper way to tell whether it changed; 148 MB of stored
         entries takes a few seconds. -->
    <!-- Two roots are the source trees, which is where every data file lives. The third is the game
         project's own build output, and it is there for the gamemode plugins: Gamemode.Plugins.targets
         copies each gamemode.dll into data/gamemodes/<id>/ of the *host's* output, never into the
         source tree, so a packaging pass over the sources alone ships the .luau scripts and silently
         omits every compiled plugin - which is why every gamemode fell back to Lua in the browser.
         That directory is earlier in the list, so its copy of the .luau files wins and the archive
         has one entry per path rather than two. -->
    <!-- After the referenced projects have built, not at PrepareForBuild: the gamemode plugins are
         produced by the game project's own build, which has not run yet when the browser head
         prepares its inputs, so the archive would be packed from a directory that is still empty.
         PrepareResources is past ResolveProjectReferences and still ahead of anything that consumes
         the archive. -->
    <Target Name="PackData" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'" BeforeTargets="PrepareResources">
        <Exec Command="&quot;$(EmscriptenPythonToolsPath)python.exe&quot; &quot;$(MSBuildThisFileDirectory)pack_data.py&quot; &quot;$(MSBuildThisFileDirectory)wwwroot&quot; &quot;$(MSBuildThisFileDirectory)..\nfm-world\bin\$(Configuration)\net11.0\data&quot; &quot;$(MSBuildThisFileDirectory)..\nfm-world\data&quot; &quot;$(MSBuildThisFileDirectory)..\NFMWorld.Library\data&quot;"
              StandardOutputImportance="normal" />
    </Target>

    <!-- The plugin API roots: host assemblies, and the framework facades plus System.Private.CoreLib
         a plugin's own IL binds against. Shared with the desktop head so the two cannot drift.
         CasCore's own framework surface (NFMWorld/PluginSandbox.linker.xml) is imported too: the
         sandbox runs here as well, and its groups bind framework members by name, so the trimmer
         would otherwise drop every one the game's own code never reaches - the probe build failed
         with "Could not load file or assembly 'System.Collections.Concurrent'" without it. -->
    <ItemGroup>
        <TrimmerRootDescriptor Include="..\PluginTypes.linker.xml" />
        <TrimmerRootDescriptor Include="..\NFMWorld\PluginSandbox.linker.xml" />
    </ItemGroup>

    <ItemGroup>
        <!-- NFMWorld.Game swaps its Hexa.NET.ImGui package for NFMWorld.ImGui.Browser when
             NfmwBrowser is set, so nothing has to be listed here. -->
        <ProjectReference Include="..\nfm-world\NFMWorld.Game.csproj"
                          AdditionalProperties="NfmwBrowser=$(NfmwBrowser)" />
        <ProjectReference Include="..\NFMWorld.Interop.Browser\NFMWorld.Interop.Browser.csproj" />
        <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj" />
        <!-- Both build a native archive that this project links as a NativeFileReference. Their
             build targets are keyed on RuntimeIdentifier, and MSBuild strips the RID from every
             project reference (Microsoft.Common.CurrentVersion.targets, RemoveProperties), so as
             plain references they never run and the link fails on a missing archive. They are
             built from BuildNativeArchives below instead, with the RID as an explicit global
             property. -->
        <ProjectReference Include="..\NFMWorld.Platform.SDL3.Browser\NFMWorld.Platform.SDL3.Browser.csproj" />
        <ProjectReference Include="..\NFMWorld.Platform.WebGL\NFMWorld.Platform.WebGL.csproj" />
        <ProjectReference Include="..\NFMWorld.Platform.WebGPU\NFMWorld.Platform.WebGPU.csproj" />
        <ProjectReference Include="..\SDL3-CS\SDL3\SDL3.Core.csproj" Aliases="SDL3New" />
    </ItemGroup>

    <!-- WorldGame lives in the desktop exe project, not in NFMWorld.Game, so the two heads share
         the source rather than a binary: the game object, its renderer switch and its frame body
         are the same file on both. Compiling it here is what keeps a browser fix from being
         invisible to the desktop build and vice versa. -->
    <ItemGroup>
        <Compile Include="..\NFMWorld\WorldGame.cs" Link="Shared\WorldGame.cs" />
        <Compile Include="..\NFMWorld\WorldGame.Recovery.cs" Link="Shared\WorldGame.Recovery.cs" />
        <Compile Include="..\NFMWorld\GlobalUsings.cs" Link="Shared\GlobalUsings.cs" />
    </ItemGroup>

    <ItemGroup>
        <WasmExtraFilesToDeploy Include="wwwroot\index.html" />
        <WasmExtraFilesToDeploy Include="wwwroot\main.js" />
        <WasmExtraFilesToDeploy Include="wwwroot\audio.js" />
        <WasmExtraFilesToDeploy Include="wwwroot\http.js" />
        <WasmExtraFilesToDeploy Include="wwwroot\data.boot.zip" />
        <WasmExtraFilesToDeploy Include="wwwroot\data.music.zip" />
    </ItemGroup>

    <Import Project="..\BuildMetadata.targets" />
</Project>

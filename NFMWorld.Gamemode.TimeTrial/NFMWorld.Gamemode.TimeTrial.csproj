<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
        <GamemodeId>nfmm/timetrial</GamemodeId>
    </PropertyGroup>

    <!-- Names the assembly gamemode.dll and copies the build output into the host
         that is building this project. See the file for why both live there. -->
    <Import Project="..\Gamemode.Plugin.props" />

    <ItemGroup>
        <ProjectReference Include="..\FixedMathSharp\src\FixedMathSharp\FixedMathSharp.csproj" Private="false" ExcludeAssets="runtime" />
        <ProjectReference Include="..\MemoryPack\src\MemoryPack.Core\MemoryPack.Core.csproj" Private="false" ExcludeAssets="runtime" />
        <ProjectReference Include="..\NFMWorld.DriverInterface\NFMWorld.DriverInterface.csproj" Private="false" ExcludeAssets="runtime" />
        <!-- Control.Encode()/Decode() traffic in Maxine.Extensions' Nibble<T>, which
             this project names directly. Explicit because transitive project
             references are off, and the host already ships the assembly. -->
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions\Maxine.Extensions.csproj" Private="false" ExcludeAssets="runtime" />
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="..\MemoryPack\src\MemoryPack\MemoryPack.csproj" Private="false" ExcludeAssets="runtime"/>

        <ProjectReference Include="..\MemoryPack\src\MemoryPack.Generator\MemoryPack.Generator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

</Project>

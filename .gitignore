*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

**/obj
**/bin

# BenchmarkDotNet writes its summaries, logs and generated projects here.
**/BenchmarkDotNet.Artifacts/

.idea
*.user

/.vscode

/publish
/nfm-world/GPUCache
/nfm-world/DawnCache

Generated
# The exception: this binding's generated sources are the binding, not build output. Nothing in
# the build regenerates them (they come from HexaGen, run by hand), so ignoring them leaves a
# clean checkout without ImFontPtr, ImGuiInputTextFlags and the rest - the browser head then
# fails to compile with CS0246 on every one.
!/NFMWorld.ImGui.Browser/src/Generated/
/nfm-world/imgui.ini
/imgui.ini

shadercache
gamemode.dll
gamemode.pdb
gamemode.deps.json

# Browser build's data archives: produced by pack_data.py on every build, and the music one is
# 148 MB of the game's own asset tree.
/NFMWorld.Browser/wwwroot/data.boot.zip
/NFMWorld.Browser/wwwroot/data.music.zip

# libopenmpt for wasm: built by web.yml's Linux job (or build-libopenmpt.sh locally), never
# checked in - it is a 15 MB archive that only changes when the library is upgraded.
/NFMWorld.Platform.WebGL/native/libopenmpt.a

# 3.7 GB of upstream sokol examples and binaries. Nothing in this tree builds against it any more
# - the cimgui sources the browser head needs are the submodule at
# NFMWorld.Platform.WebGL/ext/cimgui - so it must not be committed by accident.
/Sokol.NET/

/scratch
/data/cfg/config.cfg

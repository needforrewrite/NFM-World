@page
@model NFMWorld.Archive.Pages.IndexModel
@{
    ViewData["Title"] = "Account";
}

<header class="asset-header">
    <h1 class="username">@Model.Account!.Username</h1>
    @if (Model.Account.Role >= NFMWorldLibrary.Multiplayer.UserRole.Moderator)
    {
        <span class="asset-kind">@Model.Account.Role</span>
    }
    <a asp-page="/Profile" asp-route-id="@Model.Account.Id" role="button" class="secondary outline header-action">View public profile</a>
</header>

<h2>Ratings</h2>
@if (Model.Ratings.Count == 0)
{
    <p class="muted">No ranked matches yet.</p>
}
else
{
    <div class="overflow-auto">
        <table>
            <thead>
                <tr><th scope="col">Gamemode</th><th scope="col">Elo</th><th scope="col">Wins</th><th scope="col">Losses</th><th scope="col">Matches</th></tr>
            </thead>
            <tbody>
                @foreach (var rating in Model.Ratings)
                {
                    <tr>
                        <td>@rating.Gamemode</td>
                        <td>@Math.Round(rating.Elo)</td>
                        <td>@rating.Wins</td>
                        <td>@rating.Losses</td>
                        <td>@rating.Matches</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="section-toolbar">
    <div>
        <h2>Your content</h2>
        <p class="muted">@Model.AssetCount uploaded assets · @Model.TimeTrialCount time trials</p>
    </div>
    <a href="/upload" role="button">Upload asset</a>
</div>
@if (Model.Assets.Count > 0)
{
    <div class="overflow-auto">
        <table>
            <thead>
                <tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Downloads</th><th scope="col">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var asset in Model.Assets)
                {
                    <tr>
                        <td>
                            @if (asset.IsListed)
                            {
                                <a href="/asset/@asset.Id">@asset.Name</a>
                            }
                            else
                            {
                                @asset.Name
                            }
                        </td>
                        <td>@asset.Type</td>
                        <td>
                            @if (asset.IsTakedown)
                            {
                                <span class="muted">Removed by moderation</span>
                            }
                            else if (asset.ReviewStatus is NFMWorld.Archive.Data.AssetReviewStatus.Pending or NFMWorld.Archive.Data.AssetReviewStatus.Rejected)
                            {
                                <span class="muted">@(asset.ReviewStatus == NFMWorld.Archive.Data.AssetReviewStatus.Pending ? "Pending verification" : "Rejected")</span>
                            }
                            else if (!asset.IsPublic)
                            {
                                <span class="muted">Hidden</span>
                            }
                            else
                            {
                                <span>Listed</span>
                            }
                        </td>
                        <td>@asset.DownloadCount</td>
                        <td class="table-actions">
                            <a href="/asset/@asset.Id/edit" role="button" class="secondary outline">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@asset.Id"
                                  onsubmit="return confirm('Delete this upload permanently?');">
                                <button type="submit" class="secondary outline">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.AssetCount > Model.Assets.Count)
    {
        <p class="muted">Showing the @Model.Assets.Count most recent uploads.</p>
    }
}

@{
    var viewer = ViewData["Viewer"] as NFMWorld.Archive.Pages.ViewerState;
    var preview = ViewData["Preview"] as NFMWorld.Archive.AssetPreview.PreviewRequest;
    var page = ViewContext.RouteData.Values["page"] as string ?? "";
    var currentTab = page switch
    {
        "/AssetDetail" or "/AssetEdit" => "/Browse",
        "/Profile" => "/Profiles",
        _ when page.StartsWith("/Account/") => "/Index",
        _ when page.StartsWith("/Moderation/") => "/Moderation/Users",
        _ => page
    };
    string? Current(string tab) => page == tab ? "page" : currentTab == tab ? "true" : null;

    // The page this shell is showing, in the form the navigation script needs to rebuild it.
    var title = ViewData["Title"] as string ?? "Archive";
}
<!DOCTYPE html>
<html lang="en" data-theme="dark" data-compact>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · NFM World Archive</title>
    <link rel="stylesheet" href="~/lib/blades/blades.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/archive.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="archive-shell site-header">
    <div class="site-masthead">
        <a class="archive-brand" asp-page="/Browse">
            <img src="~/branding/logo.svg" asp-append-version="true" alt="NFM World" width="100" height="56" />
            <span>Archive</span>
        </a>
        <div class="account-menu">
            @if (viewer?.Username is { } username)
            {
                <a href="/account/security">@username</a>
                <form method="post" action="/logout">
                    <button type="submit" class="secondary outline">Sign out</button>
                </form>
            }
            else
            {
                <a href="/account/login" role="button" class="secondary outline">Sign in</a>
            }
        </div>
    </div>
    <nav aria-label="Main navigation">
        <ul class="archive-tabs">
            <li><a href="/" aria-current="@Current("/Index")">Account</a></li>
            <li><a href="/browse" aria-current="@Current("/Browse")">Browse</a></li>
            <li><a asp-page="/Profiles" aria-current="@Current("/Profiles")">Profiles</a></li>
            <li><a href="/leaderboards" aria-current="@Current("/Leaderboards")">Time trials</a></li>
            <li><a href="/clans" aria-current="@Current("/Clans")">Clans</a></li>
            <li><a href="/upload" aria-current="@Current("/Upload")">Upload</a></li>
            @if (viewer?.IsStaff == true)
            {
                <li><a href="/moderation" aria-current="@Current("/Moderation/Users")">Moderation</a></li>
            }
            @if (viewer?.IsAdmin == true)
            {
                <li><a href="/administration" aria-current="@Current("/Administration")">Administration</a></li>
            }
        </ul>
    </nav>
</header>
<main class="archive-shell page-shell">
    <div class="page-columns@(preview is null ? "" : " preview-on")" id="page-columns">
        @* The swap target. js/shell.js replaces this element's contents, never the preview beside
           it: a frame is destroyed the moment it leaves the document, which is the whole cost this
           shell exists to avoid. *@
        <div id="main-content" tabindex="-1">
            @if (ViewData["Viewer"] is NFMWorld.Archive.Pages.ViewerState { DeletionEraseAt: { } eraseAt })
            {
                <div class="error" role="alert" style="margin-bottom: 1rem;">
                    Account deletion scheduled for @eraseAt.UtcDateTime.ToString("yyyy-MM-dd").
                    <form method="post" action="/account/deletion?handler=Cancel" style="display:inline;">
                        <button type="submit" class="secondary outline">Cancel deletion</button>
                    </form>
                </div>
            }
            @RenderBody()
        </div>
        @if (preview is null)
        {
            <aside class="asset-viewer" id="preview-host" aria-label="3D preview" hidden></aside>
        }
        else
        {
            <aside class="asset-viewer" id="preview-host" aria-label="3D preview">
                <iframe id="preview-frame" src="@preview.Url" title="3D preview of @title" allowfullscreen></iframe>
            </aside>
        }
    </div>
</main>
<script src="~/js/shell.js" asp-append-version="true" defer></script>
</body>
</html>

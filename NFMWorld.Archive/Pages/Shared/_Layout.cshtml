<!DOCTYPE html>
<html lang="en" data-theme="dark" data-compact>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · NFM World Archive</title>
    <link rel="stylesheet" href="~/lib/blades/blades.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/archive.css" asp-append-version="true" />
</head>
<body>
<header class="container site-header">
    <nav aria-label="Main navigation">
        <ul>
            <li><strong>NFM WORLD ARCHIVE</strong></li>
        </ul>
        <ul>
            <li><a href="/">Account</a></li>
            <li><a href="/browse">Browse</a></li>
            <li><a href="/leaderboards">Time trials</a></li>
            <li><a href="/clans">Clans</a></li>
            <li><a href="/upload">Upload</a></li>
        </ul>
        <ul class="account-menu">
            @{
                var viewer = ViewData["Viewer"] as NFMWorld.Archive.Pages.ViewerState;
            }
            @if (viewer?.Username is { } username)
            {
                <li class="muted">@username</li>
                <li>
                    <form method="post" action="/logout">
                        <button type="submit" class="secondary outline">Sign out</button>
                    </form>
                </li>
            }
            else
            {
                <li><a href="/account/login">Sign in</a></li>
            }
        </ul>
    </nav>
</header>
<main class="container" id="main-content">
    @RenderBody()
</main>
</body>
</html>

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-compact>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · NFM World Archive</title>
    <link rel="stylesheet" href="~/lib/blades/blades.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/archive.css" asp-append-version="true" />
</head>
<body>
<header class="container site-header">
    <nav aria-label="Main navigation">
        <ul>
            <li><strong>NFM WORLD ARCHIVE</strong></li>
        </ul>
        <ul>
            <li><a href="/">Account</a></li>
            <li><a href="/browse">Browse</a></li>
            <li><a asp-page="/Profiles">Profiles</a></li>
            <li><a href="/leaderboards">Time trials</a></li>
            <li><a href="/clans">Clans</a></li>
            <li><a href="/upload">Upload</a></li>
            @{
                var viewer = ViewData["Viewer"] as NFMWorld.Archive.Pages.ViewerState;
            }
            @if (viewer?.IsStaff == true)
            {
                <li><a href="/moderation">Moderation</a></li>
            }
            @if (viewer?.IsAdmin == true)
            {
                <li><a href="/administration">Administration</a></li>
            }
        </ul>
        <ul class="account-menu">
            @if (viewer?.Username is { } username)
            {
                <li class="muted"><a href="/account/security">@username</a></li>
                <li>
                    <form method="post" action="/logout">
                        <button type="submit" class="secondary outline">Sign out</button>
                    </form>
                </li>
            }
            else
            {
                <li><a href="/account/login">Sign in</a></li>
            }
        </ul>
    </nav>
</header>
<main class="container" id="main-content">
    @if (ViewData["Viewer"] is NFMWorld.Archive.Pages.ViewerState { DeletionEraseAt: { } eraseAt })
    {
        <div class="error" role="alert" style="margin-bottom: 1rem;">
            Account deletion scheduled for @eraseAt.UtcDateTime.ToString("yyyy-MM-dd").
            <form method="post" action="/account/deletion?handler=Cancel" style="display:inline;">
                <button type="submit" class="secondary outline">Cancel deletion</button>
            </form>
        </div>
    }
    @RenderBody()
</main>
</body>
</html>

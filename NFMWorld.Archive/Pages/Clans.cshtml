@page
@model NFMWorld.Archive.Pages.ClansModel
@{
    ViewData["Title"] = "Clans";
}

<h1>Clans</h1>

@if (Model.Error is not null)
{
    <p class="error">@Model.Error</p>
}

@if (Model.MyClan is not null)
{
    <p>You are in
        <strong>@Model.MyClan.Name</strong>@(string.IsNullOrEmpty(Model.MyClan.Tag) ? "" : $" [{Model.MyClan.Tag}]").
    </p>
    <form method="post" asp-page-handler="Leave">
        <button type="submit">Leave clan</button>
    </form>
}
else if (Model.IsSignedIn)
{
    <h2>Create a clan</h2>
    <form method="post" asp-page-handler="Create" class="row">
        <label>Name<br/><input asp-for="ClanName"/></label>
        <label>Tag<br/><input asp-for="Tag" maxlength="6"/></label>
        <button type="submit">Create</button>
    </form>
}

<h2>All clans</h2>
@if (Model.Clans.Count == 0)
{
    <p class="muted">No clans yet.</p>
}
else
{
<
    table>
        <tr>
            <th>Clan</th>
            <th>Tag</th>
            <th>Members</th>
            <th></th>
        </tr>
            @foreach (var clan in Model.)
            {
            <tr>
            <td>@clan.Name
                <td>@clan.Tag</td>
            <td>@clan..Count</td>
            <td>
                @if (.IsSignedIn && Model.is null)
                {
                <form method="post" asp-page-handler="Join" style="margin:0">
                    <input type="hidden" name="JoinClanId" value="@clan.Id"/>
            <
                button type="submit">Join</>
                </form>
            }
    </td>
    </tr>
    }
</table>
}

@page
@model NFMWorld.Archive.Pages.UploadModel
@{
    ViewData["Title"] = "Upload";
}

<h1>Upload</h1>
<p class="muted">Radpacks (or legacy .rad models). The file's own type must match the type you choose.</p>

@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
@if (Model.Message is not null)
{
    <p role="status">@Model.Message</p>
}

<form method="post" enctype="multipart/form-data">
    <label>File<input type="file" asp-for="File" accept=".radpack,.rad" /></label>
    <div class="grid">
        <label>Name<input asp-for="Name" /></label>
        <label>Type
            <select asp-for="Type">
                @foreach (var type in Model.PublishableTypes)
                {
                    <option value="@type">@type</option>
                }
            </select>
        </label>
    </div>
    <label>Description<textarea asp-for="Description" rows="3"></textarea></label>
    <button type="submit">Upload</button>
</form>

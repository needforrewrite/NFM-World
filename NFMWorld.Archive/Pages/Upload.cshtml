@page
@model NFMWorld.Archive.Pages.UploadModel
@{
    ViewData["Title"] = "Upload";
}

<h1>Upload</h1>
<p class="muted">Radpacks only. The file's own type must match the type you choose.</p>

@if (Model.Error is not null)
{
    <p class="error">@Model.Error</p>
}
@if (Model.Message is not null)
{
    <p>@Model.Message</p>
}

<form method="post" enctype="multipart/form-data">
    <div class="row">
        <label>File<br/><input type="file" asp-for="File" accept=".radpack,.rad"/></label>
        <label>Name<br/><input asp-for="Name"/></label>
        <label>Type<br/>
            <select asp-for="Type">
                @foreach (varin Enum.GetNames<>())
                {
                <value="@type">@</option>
                }
            </select>
        </label>
    </div>
    <div class="row">
        <label style="flex:1">Description<br/><textarea asp-for="Description" rows="3"
                                                        style="width:100%"></textarea></label>
    </div>
    <button type="submit">Upload</button>
</form>

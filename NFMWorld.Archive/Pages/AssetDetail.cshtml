@page "/asset/{id:int}"
@model NFMWorld.Archive.Pages.AssetDetailModel

<p><a href="/browse">← Back to browse</a></p>

<div class="asset-body">
    <header class="asset-header">
        <h1>@Model.Asset!.Name</h1>
        <span class="asset-kind">@Model.Asset.Type</span>
        @if (Model.Asset.ReviewStatus == NFMWorld.Archive.Data.AssetReviewStatus.Verified)
        {
            <span class="asset-kind">Verified</span>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Asset.Description))
    {
        <p class="asset-description">@{
            var description = Model.Asset.Description;
            var position = 0;
            foreach (var (start, length) in NFMWorld.Archive.Data.AssetTags.Find(description))
            {
                @description.Substring(position, start - position)
                var tag = description.Substring(start, length);
                <a asp-page="/Browse" asp-route-query="@tag">@tag</a>
                position = start + length;
            }
            @description.Substring(position)
        }</p>
    }
    else
    {
        <p class="muted">No description.</p>
    }

    <dl class="asset-meta">
        <dt>Creator</dt>
        <dd>
            <partial name="_AssetCreator" model="@Model.Asset.Owner" />
        </dd>

        <dt>Uploaded</dt>
        <dd>@Model.Asset.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</dd>

        <dt>Size</dt>
        <dd>@AssetDetailModel.FormatSize(Model.Asset.SizeBytes)</dd>

        <dt>Downloads</dt>
        <dd>@Model.Asset.DownloadCount</dd>

        <dt>SHA-256</dt>
        <dd><code class="asset-hash">@Model.Asset.ContentHash</code></dd>
    </dl>

    <p class="asset-actions">
        <a href="/assets/@Model.Asset.ContentHash" role="button" data-spa="off">Download @Model.Asset.Type</a>
    </p>
</div>

@if (Model.CanEdit)
{
    <p><a href="/asset/@Model.Asset.Id/edit" role="button" class="secondary">Edit this upload</a></p>
}

@if (Model.More.Count > 0)
{
    <h2>More from <partial name="_AssetCreator" model="@Model.Asset.Owner" /></h2>
    <ul class="asset-list">
        @foreach (var more in Model.More)
        {
            <li><a href="/asset/@more.Id">@more.Name</a> <span class="muted">@more.Type</span></li>
        }
    </ul>
}

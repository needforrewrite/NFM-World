@page
@model NFMWorld.Archive.Pages.BrowseModel
@{
    ViewData["Title"] = "Browse";
}

<h1>Browse</h1>

<form method="get" class="row">
    <input name="query" value="@Model.Query" placeholder="Search by name"/>
    <select name="type">
        <option value="">Any type</option>
        @
        foreach (type in Enum.GetNames<>())
        {
        <
            option value="@type" selected="@(Model.Type == type)">@type}
    </select>
    <button type="submit">Search</button>
</form>

@

if (.Assets.Count == 0)
{
<
    p class="muted">Nothing here yet.</p>
}
else
{
<
    table>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Size</th>
            <th>Downloads</th>
        </tr>
            @foreach (var asset
            in Model.Assets)
            {
            <>
            <td><a href="/assets/@asset.">@asset.Name</a></>
            <td>@asset.Type
                <td>@((asset.SizeBytes / 1024) + " KB")</td>
        <td>@asset.</td>
    </tr>
    }
</table>
}

@page
@model NFMWorld.Archive.Pages.LeaderboardsModel
@{
    ViewData["Title"] = "Time trials";
}

<h1>Time trials</h1>

@if (Model.Boards.Count == 0)
{
    <p class="muted">No verified time trials yet.</p>
}
else
{
    <form method="get" class="grid filter-form">
        <label>Stage
            <select name="stageHash" onchange="this.form.carHash.value='';this.form.submit()">
                @foreach (var board in Model.Boards.GroupBy(b => (b.StageHash, b.StageName)))
                {
                    <option value="@board.Key.StageHash" selected="@(Model.StageHash == board.Key.StageHash)">@board.Key.StageName</option>
                }
            </select>
        </label>
        <label>Car
            <select name="carHash" onchange="this.form.submit()">
                @foreach (var board in Model.Boards.Where(b => b.StageHash == Model.StageHash))
                {
                    <option value="@board.CarHash" selected="@(Model.CarHash == board.CarHash)">@board.CarName</option>
                }
            </select>
        </label>
        <button type="submit">Show</button>
    </form>

    <div class="overflow-auto">
        <table>
            <thead>
                <tr><th scope="col">#</th><th scope="col">Player</th><th scope="col">Time</th><th scope="col">Set</th><th scope="col">Replay</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Entries.Count; i++)
                {
                    var entry = Model.Entries[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@entry.User.Username</td>
                        <td>@TimeSpan.FromSeconds(entry.TotalTicks / (double)NFMWorldLibrary.Physics.TargetTps).ToString(@"m\:ss\.fff")</td>
                        <td>@entry.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td><a href="/tt/replay/@entry.Id">Replay</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

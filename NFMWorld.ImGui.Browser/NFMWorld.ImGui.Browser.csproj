<Project Sdk="Microsoft.NET.Sdk">

    <!-- A wasm-capable replacement for Hexa.NET.ImGui.
         That package resolves every entry point through a function pointer loaded with
         NativeLibrary.TryGetExport, and on this runtime a loaded handle cannot produce callable
         addresses (GetMainProgramHandle throws outright). The same generated API surface, built
         with HexaGen's DllImport flavour instead, resolves through the P/Invoke table, which does
         work on wasm. Only the browser head references this; desktop keeps the package. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>Hexa.NET.ImGui</AssemblyName>
        <RootNamespace>Hexa.NET.ImGui</RootNamespace>
        <!-- Generated code, not ours to keep clean. -->
        <NoWarn>$(NoWarn);CS1591;CS0618;CS8500;CS8600;CS8602;CS8603;CS8625</NoWarn>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
        <IsAotCompatible>false</IsAotCompatible>
        <IsTrimmable>false</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HexaGen.Runtime" Version="1.1.21" />
    </ItemGroup>

</Project>

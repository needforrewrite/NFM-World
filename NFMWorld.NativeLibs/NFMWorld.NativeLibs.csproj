<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <!-- PreserveNewest, not Always: Always rewrote every native DLL into each
             dependent project's output on every build, which fails against a running
             instance that has them loaded and forced a rebuild to be a relaunch blocker. -->
        <None Include="libs\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="libs\"/>
    </ItemGroup>

</Project>

<Project>

    <!--
        Builds the .NET gamemode projects and copies each into data/gamemodes/<id>/,
        next to that gamemode's .luau scripts. Import from the host whose output
        should carry them (the game host, the server).

        A .targets rather than inline XML for the same reason as the shader
        compile: the set of gamemodes is data, and adding one should not mean
        editing the host project. The plugin projects themselves do not import
        this - they are the things being built.

        The destination is passed down rather than copied here so that each plugin
        copies only its own output. Collecting every plugin's assembly here and
        copying them in one batch would apply the first item's metadata to all of
        them (MSBuild does not batch a task on a child item's metadata), silently
        giving every gamemode the same destination folder.
    -->

    <ItemGroup>
        <GamemodePlugin Include="Pvp">
            <Project>$(MSBuildThisFileDirectory)NFMWorld.Gamemode.Pvp\NFMWorld.Gamemode.Pvp.csproj</Project>
            <GamemodeId>nfmm/pvp</GamemodeId>
        </GamemodePlugin>
        <GamemodePlugin Include="TimeTrial">
            <Project>$(MSBuildThisFileDirectory)NFMWorld.Gamemode.TimeTrial\NFMWorld.Gamemode.TimeTrial.csproj</Project>
            <GamemodeId>nfmm/timetrial</GamemodeId>
        </GamemodePlugin>
    </ItemGroup>

    <!--
        Before AssignTargetPaths because that is where the SDK's content items are
        given a TargetPath to copy to, and it runs inside PrepareResources - early
        in the build, before the plugins would otherwise have been built at all.
        The copy therefore has to already have happened by then.

        Unconditional, and the plugins are free to build on their own: MSBuild
        de-duplicates nested build requests, so importing this from two projects
        builds each plugin once.
    -->
    <Target Name="BuildGamemodePlugins"
            BeforeTargets="AssignTargetPaths"
            Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(DesignTimeBuild)' != 'true'">
        <!-- Read here, not at evaluation time. TargetDir is defined by the SDK's
             .targets, which are imported after the project body, so a PropertyGroup
             up there sees it empty and the copy destination silently degrades to a
             path relative to the *plugin's* directory. -->
        <PropertyGroup>
            <GamemodeOutputRoot>$(TargetDir)data/gamemodes</GamemodeOutputRoot>
        </PropertyGroup>
        <!-- Build must re-evaluate the project after restore generates its NuGet imports. -->
        <MSBuild Projects="%(GamemodePlugin.Project)"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration);GamemodeOutputRoot=$(GamemodeOutputRoot);GamemodeId=%(GamemodePlugin.GamemodeId);ExcludeRestorePackageImports=true" />
        <MSBuild Projects="%(GamemodePlugin.Project)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);GamemodeOutputRoot=$(GamemodeOutputRoot);GamemodeId=%(GamemodePlugin.GamemodeId)" />
    </Target>

    <!--
        Carries the built plugins into `dotnet publish`.

        They land in $(TargetDir)data/gamemodes/<id>/, but the output directory is not the source
        of what gets published: publish collects the project's items, and the only gamemode items
        are the .luau files that shipped by the data/** glob. So a plain build had gamemode.dll and
        a published build did not - and with no assembly there, GamemodeFactory falls back to the
        Luau script of the same id, which is why the compiled gamemodes appeared to be missing
        from release builds only.

        Read from GamemodeOutputRoot - the output of the project that built the plugins, which for
        a publish is NFMWorld.Game's, not the host being published (NFMWorld). Those are different
        directories, especially under a runtime identifier.
    -->
    <Target Name="PublishGamemodePlugins"
            BeforeTargets="ComputeResolvedFilesToPublishList"
            DependsOnTargets="BuildGamemodePlugins">
        <ItemGroup>
            <!-- Read from the output of the project that built the plugins (GamemodeOutputRoot),
                 not from this host's, and not from the plugin's own bin, which still holds the
                 original assembly name rather than gamemode.dll. `**` rather than `*` because
                 only the recursive wildcard fills in RecursiveDir, which carries the gamemode id.

                 A private item type, updated with a qualified self-reference, rather than
                 setting RelativePath directly on ResolvedFileToPublish: that item already has
                 RelativePath from the SDK, so `%(Filename)` there is a self-reference and MSBuild
                 applies it over every existing publish item instead of just these. -->
            <GamemodePluginPublish Include="$(GamemodeOutputRoot)/**/gamemode.*">
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </GamemodePluginPublish>
            <GamemodePluginPublish>
                <RelativePath>data/gamemodes/%(GamemodePluginPublish.RecursiveDir)%(GamemodePluginPublish.Filename)%(GamemodePluginPublish.Extension)</RelativePath>
            </GamemodePluginPublish>
            <ResolvedFileToPublish Include="@(GamemodePluginPublish)" />
        </ItemGroup>
    </Target>

</Project>

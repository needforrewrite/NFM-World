<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1"/>
        <PackageReference Include="MSTest.TestAdapter" Version="4.0.2"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj"/>
        <ProjectReference Include="..\NFMWorld.ClientOnlyAnalyzer\NFMWorld.ClientOnlyAnalyzer.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\NFMWorld.UI\NFMWorld.UI.csproj"/>
        <!-- Session lifecycle (load timeout, bot fill) is server-side behaviour worth testing. -->
        <ProjectReference Include="..\NFMWorld.Server.Lobby\NFMWorld.Server.Lobby.csproj"/>
    </ItemGroup>

    <!-- So the gamemode plugin loader tests exercise the real built plugins, and so a
         regression in the plugin build wiring fails the suite. -->
    <ItemGroup>
        <Plugin Include="Pvp">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Gamemode.Pvp\NFMWorld.Gamemode.Pvp.csproj</Project>
            <PluginId>nfmm/pvp</PluginId>
            <PluginDirectory>gamemodes</PluginDirectory>
            <PluginFileName>gamemode</PluginFileName>
        </Plugin>
        <Plugin Include="TimeTrial">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Gamemode.TimeTrial\NFMWorld.Gamemode.TimeTrial.csproj</Project>
            <PluginId>nfmm/timetrial</PluginId>
            <PluginDirectory>gamemodes</PluginDirectory>
            <PluginFileName>gamemode</PluginFileName>
        </Plugin>
        <Plugin Include="ElStupido">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Ai.ElStupido\NFMWorld.Ai.ElStupido.csproj</Project>
            <PluginId>el_stupido</PluginId>
            <PluginDirectory>ais</PluginDirectory>
            <PluginFileName>ai</PluginFileName>
        </Plugin>
        <Plugin Include="Classic">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Ai.Classic\NFMWorld.Ai.Classic.csproj</Project>
            <PluginId>classic</PluginId>
            <PluginDirectory>ais</PluginDirectory>
            <PluginFileName>ai</PluginFileName>
        </Plugin>
        <!-- The sandbox probes: PluginSandboxTests loads this and asserts every hostile
             reach is refused. Test-only, and Debug-only where the game hosts build it. -->
        <Plugin Include="Hostile">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Gamemode.Hostile\NFMWorld.Gamemode.Hostile.csproj</Project>
            <PluginId>sandbox/hostile</PluginId>
            <PluginDirectory>gamemodes</PluginDirectory>
            <PluginFileName>gamemode</PluginFileName>
        </Plugin>
    </ItemGroup>

    <Import Project="..\Plugin.Plugins.targets"/>

</Project>

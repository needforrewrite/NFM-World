<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
        <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj"/>
        <ProjectReference Include="..\NFMWorld.ClientOnlyAnalyzer\NFMWorld.ClientOnlyAnalyzer.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\NFMWorld.UI\NFMWorld.UI.csproj"/>
        <!-- Session lifecycle (load timeout, bot fill) is server-side behaviour worth testing. -->
        <ProjectReference Include="..\NFMWorld.Server.Lobby\NFMWorld.Server.Lobby.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\NFMWorld.Updater\Shared\*.cs;..\NFMWorld.Updater\*.cs" Link="Updates\%(Filename)%(Extension)" />
        <Compile Include="..\nfm-world\Mad\Gameplay\MenuHistory.cs" Link="MenuHistory.cs"/>
        <Compile Include="..\nfm-world\Content\LoadingWork.cs" Link="LoadingWork.cs"/>
        <Compile Include="..\nfm-world\UI\Routes\AccountView.cs" Link="AccountView.cs"/>
        <Compile Include="..\nfm-world\UI\Routes\ReplayBrowserView.cs" Link="ReplayBrowserView.cs"/>
        <Compile Include="..\nfm-world\UI\Routes\StageSelectView.cs" Link="StageSelectView.cs"/>
        <Compile Include="..\nfm-world\UI\ViewModels\HsbColorState.cs" Link="HsbColorState.cs"/>
        <Compile Include="..\nfm-world\UI\ViewModels\RaceChatState.cs" Link="RaceChatState.cs"/>
        <Compile Include="..\nfm-world\UI\ViewModels\RaceFinishState.cs" Link="RaceFinishState.cs"/>
        <Compile Include="..\nfm-world\Mad\Gameplay\LobbyStageSelection.cs" Link="LobbyStageSelection.cs"/>
        <Compile Include="..\nfm-world\UI\Components\Button.cs" Link="Button.cs"/>
        <Compile Include="..\nfm-world\UI\Components\Controls.cs" Link="Controls.cs"/>
        <Compile Include="..\nfm-world\UI\Components\LoadingSpinner.cs" Link="LoadingSpinner.cs"/>
        <Compile Include="..\nfm-world\UI\Components\LobbyPlayerMenu.cs" Link="LobbyPlayerMenu.cs"/>
        <Compile Include="..\nfm-world\UI\Components\NotificationCenter.cs" Link="NotificationCenter.cs"/>
        <Compile Include="..\nfm-world\UI\Components\MessageDialog.cs" Link="MessageDialog.cs"/>
        <Compile Include="..\nfm-world\Mad\UI\MessageWindow.cs" Link="MessageWindow.cs"/>
        <Compile Include="..\nfm-world\UI\Theme.cs" Link="Theme.cs"/>
        <Compile Include="..\nfm-world\Util\PngCodec.cs" Link="PngCodec.cs"/>
    </ItemGroup>

    <!-- So the gamemode plugin loader tests exercise the real built plugins, and so a
         regression in the plugin build wiring fails the suite. -->
    <ItemGroup>
        <Plugin Include="Pvp">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Gamemode.Pvp\NFMWorld.Gamemode.Pvp.csproj</Project>
            <PluginId>nfmm/pvp</PluginId>
            <PluginDirectory>gamemodes</PluginDirectory>
            <PluginFileName>gamemode</PluginFileName>
        </Plugin>
        <Plugin Include="TimeTrial">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Gamemode.TimeTrial\NFMWorld.Gamemode.TimeTrial.csproj</Project>
            <PluginId>nfmm/timetrial</PluginId>
            <PluginDirectory>gamemodes</PluginDirectory>
            <PluginFileName>gamemode</PluginFileName>
        </Plugin>
        <Plugin Include="Rocket">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Gamemode.Rocket\NFMWorld.Gamemode.Rocket.csproj</Project>
            <PluginId>nfmm/rocket</PluginId>
            <PluginDirectory>gamemodes</PluginDirectory>
            <PluginFileName>gamemode</PluginFileName>
        </Plugin>
        <Plugin Include="ElStupido">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Ai.ElStupido\NFMWorld.Ai.ElStupido.csproj</Project>
            <PluginId>el_stupido</PluginId>
            <PluginDirectory>ais</PluginDirectory>
            <PluginFileName>ai</PluginFileName>
        </Plugin>
        <Plugin Include="Classic">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Ai.Classic\NFMWorld.Ai.Classic.csproj</Project>
            <PluginId>classic</PluginId>
            <PluginDirectory>ais</PluginDirectory>
            <PluginFileName>ai</PluginFileName>
        </Plugin>
        <!-- The sandbox probes: PluginSandboxTests loads this and asserts every hostile
             reach is refused. Test-only, and Debug-only where the game hosts build it. -->
        <Plugin Include="Hostile">
            <Project>$(MSBuildThisFileDirectory)..\NFMWorld.Gamemode.Hostile\NFMWorld.Gamemode.Hostile.csproj</Project>
            <PluginId>sandbox/hostile</PluginId>
            <PluginDirectory>gamemodes</PluginDirectory>
            <PluginFileName>gamemode</PluginFileName>
        </Plugin>
    </ItemGroup>

    <Import Project="..\Plugin.Plugins.targets"/>

</Project>

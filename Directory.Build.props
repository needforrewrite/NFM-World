<Project>

    <!--
        DebugDevServer is Debug with the baked endpoints pointed at the dev stack. The SDK only
        special-cases the literal name "Debug", so without this the configuration would compile
        without DEBUG, without a PDB and optimised - a release build that happens to talk to the
        dev servers, which is not what anyone selecting it wants.

        Conditional on the name, so every other configuration is untouched.
    -->
    <PropertyGroup>
        <Configurations Condition="'$(Configurations)' == ''">Debug;Release;DebugDevServer</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'DebugDevServer'">
        <DebugSymbols Condition="'$(DebugSymbols)' == ''">true</DebugSymbols>
        <Optimize Condition="'$(Optimize)' == ''">false</Optimize>
        <DefineConstants Condition="'$(DefineConstants)' == ''">DEBUG</DefineConstants>
        <DefineConstants Condition="'$(DefineConstants)' != 'DEBUG'">$(DefineConstants);DEBUG</DefineConstants>
    </PropertyGroup>

    <!--
        The properties every nested build of a build-time tool is given: the shader compiler task
        (NFMWorld.ShaderCompiler.targets) and the MSDF baker (NFMWorld.MsdfCache.targets). One
        definition because each is a hand-maintained list handed to a nested MSBuild request, and
        they had already drifted - both cleared RuntimeIdentifier and PublishReadyToRun, and neither
        cleared SelfContained, which the release workflows pass globally. A cleared RID with
        '$(SelfContained)' still true is NETSDK1191 ("a runtime identifier for the property
        'SelfContained' couldn't be inferred"), raised on a plain Build, so a publish could not
        compile anything.

        They are cleared, not merely overridden, because they arrive as *global* properties from
        the command line (-r, -p:SelfContained, -p:PublishSingleFile) and so reach every nested
        request. The tools run on the build host and are never published, so none applies: a RID
        would also move an Exe's output to bin/<cfg>/<tfm>/<rid>/ and make the copy to the rid-less
        path pick up the same incomplete tree twice (MSB3027 on the second copy).

        TargetFramework is pinned rather than inherited: both tools project net11.0 while a
        consumer may not, and the assembly paths name net11.0 explicitly.
        Configuration is passed by each target at execution time: it may still be empty here,
        before the SDK assigns its Debug default.
    -->
    <PropertyGroup>
        <NFMWorldBuildHostToolProperties>TargetFramework=net11.0;RuntimeIdentifier=;SelfContained=false;PublishSingleFile=false;PublishReadyToRun=false</NFMWorldBuildHostToolProperties>
    </PropertyGroup>

</Project>

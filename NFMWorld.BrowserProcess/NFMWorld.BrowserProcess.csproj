<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NFMWorld.BrowserProcess</AssemblyName>
    <RootNamespace>NFMWorld.BrowserProcess</RootNamespace>
    <RuntimeIdentifiers>osx-x64;osx-arm64;win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PublishCommonConfig>Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework);IsPublishing=True;PublishTrimmed=True;SelfContained=True;RuntimeIdentifier=</PublishCommonConfig>
    <IsEditbinEnabled>True</IsEditbinEnabled>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ObjectBinding\CefGlueGlobalScript.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefGlue.Common" Version="120.6099.211" />
  </ItemGroup>

  <Target Name="EnsureCefGlueMacRuntimeLibrariesInOutDir"
          BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory"
          Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'">
    <ItemGroup>
      <_CefMacRuntimeLibraries Include="@(CefRedistOSX64);@(CefRedistOSXARM64)"
                               Condition="'%(Filename)%(Extension)' == 'libEGL.dylib' or '%(Filename)%(Extension)' == 'libGLESv2.dylib' or '%(Filename)%(Extension)' == 'libvk_swiftshader.dylib'" />
      <_CefMacRuntimeLibrariesToCopy Include="@(_CefMacRuntimeLibraries)"
                                     Condition="!Exists('$(OutDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_CefMacRuntimeLibrariesToCopy)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_CefMacRuntimeLibrariesToCopy)' != ''" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\CefGlue.BrowserProcess\CefGlue.BrowserProcess.csproj" />
  </ItemGroup>


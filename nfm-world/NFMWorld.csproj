<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>NFMWorld</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Version>0.0.0-dev</Version>
        <InformationalVersion>NFM-World dev</InformationalVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <TieredCompilation>false</TieredCompilation>
        <OptimizationPreference>Speed</OptimizationPreference>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
        <CETCompat>false</CETCompat>
    </PropertyGroup>
    <ItemGroup>
        <!-- Exclude emitted source-generator files from implicit *.cs glob to prevent double compilation -->
        <Compile Remove="Generated/**" />
    </ItemGroup>
    <!--
         <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
         <PublishAot>true</PublishAot>
         </PropertyGroup>
    -->
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />
        <None Update="steam_appid.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
            <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
            <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Collections.Pooled" Version="2.0.0-preview.27" />
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
        <PackageReference Include="JetBrains.Profiler.Api" Version="1.4.13" />
        <PackageReference Include="LibOpenMPT.NET" Version="0.8.6" />
        <None Include="data\**\*" CopyToOutputDirectory="Always" />
        <None Remove="data\html\node_modules\**" CopyToOutputDirectory="Never" />
        <None Remove="data\html\dist\**" CopyToOutputDirectory="Never" />
        <None Include="src\**\*" CopyToOutputDirectory="Always" />
        <None Remove="src\data\.git\**" CopyToOutputDirectory="Never" />
        <None Remove="src\data\.git" CopyToOutputDirectory="Never" />
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
        <PackageReference Include="NAudio" Version="3.0.0-preview.18" />
        <PackageReference Include="NAudio.SoundFile" Version="3.0.0-preview.18" />
        <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
        <PackageReference Include="NLayer" Version="2.0.1" />
        <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
        <PackageReference Include="NVorbis" Version="1.0.0-rc.2" />
        <PackageReference Include="org.sndfile.runtime.linux-arm64" Version="1.2.2.1" />
        <PackageReference Include="org.sndfile.runtime.linux-x64" Version="1.2.2.1" />
        <PackageReference Include="org.sndfile.runtime.osx-arm64" Version="1.2.2" />
        <PackageReference Include="org.sndfile.runtime.osx-x64" Version="1.2.2" />
        <PackageReference Include="org.sndfile.runtime.win-arm64" Version="1.2.2" />
        <PackageReference Include="org.sndfile.runtime.win-x64" Version="1.2.2" />
        <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
        <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
        <PackageReference Include="System.Reactive" Version="7.0.0-rc.1" />
    </ItemGroup>
    <!--
         Prevent CefGlue.Common NuGet from copying its bundled self-contained browser process
         (Xilium.CefGlue.BrowserProcess.exe + entire .NET runtime) to output/publish.
         NFMWorld.BrowserProcess.exe already compiles all CefGlue.BrowserProcess source via ProjectReference.
    -->
    <ItemGroup>
        <CefGlueBrowserProcessFiles Remove="@(CefGlueBrowserProcessFiles)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\CefGlue\CefGlue.BrowserProcess\CefGlue.BrowserProcess.csproj" />
        <ProjectReference Include="..\CefGlue\CefGlue.Common\CefGlue.Common.csproj" />
        <ProjectReference Include="..\CefGlue\CefGlue\CefGlue.csproj" />
        <ProjectReference Include="..\HoleyDiver\HoleyDiver.csproj" />
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions\Maxine.Extensions.csproj" />
        <ProjectReference Include="..\Maxine.Extensions\RayTech.RayLog.MEL\RayTech.RayLog.MEL.csproj" />
        <ProjectReference Include="..\MonoGame.ImGuiNet\MonoGame.ImGuiNet\Monogame.ImGuiNet.csproj" />
        <ProjectReference Include="..\NanoSvgSharp\NanoSvgSharp.csproj" />
        <ProjectReference Include="..\NAudio.Flac\NAudio.Flac\NAudio.Flac.csproj" />
        <ProjectReference Include="..\NFMWorld.Api\NFMWorld.Api.csproj" />
        <ProjectReference Include="..\NFMWorld.Audio.FAudio\NFMWorld.Audio.FAudio.csproj" />
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj" />
        <ProjectReference Include="..\NFMWorld.Multiplayer.Base\NFMWorld.Multiplayer.Base.csproj" />
        <ProjectReference Include="..\NFMWorld.NativeLibs\NFMWorld.NativeLibs.csproj" />
        <ProjectReference Include="..\NvgSharp\src\NvgSharp.Text\NvgSharp.Text.FNA.Core.csproj" />
        <ProjectReference Include="..\NvgSharp\src\XNA\NvgSharp.FNA.Core.csproj" />

        <!--
            Milestone 5 Stage A: window/device ownership via SDL3 + FNA3D instead of FNA's
            Game/GraphicsDeviceManager. This project also still references FNA transitively (via
            NvgSharp.FNA.Core, until Stage C), whose own private, separately-compiled copy of
            SDL3.Core's SDL type would otherwise collide (CS0433) with SDL3.Core's - SDK-style
            transitive project references don't carry NFMWorld.Platform.SDL3's own <Aliases> on its
            SDL3.Core reference through to this project, so it's aliased again, explicitly, here.
            Nothing in nfm-world's own code needs to reference the SDL3New-aliased type directly.
        -->
        <ProjectReference Include="..\FNA\lib\SDL3-CS\SDL3\SDL3.Core.csproj" Aliases="SDL3New" />
        <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
        <ProjectReference Include="..\NFMWorld.Graphics.FNA3D\NFMWorld.Graphics.FNA3D.csproj" />
        <ProjectReference Include="..\NFMWorld.Platform.SDL3\NFMWorld.Platform.SDL3.csproj" />

        <!-- Reference NFMWorld.ShaderSourceGen for XAML source generation -->
        <ProjectReference Include="..\NFMWorld.ShaderSourceGen\NFMWorld.ShaderSourceGen.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.UnionGen\Maxine.Extensions.UnionGen.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.UnionGen.Base\Maxine.Extensions.UnionGen.Base.csproj" />

        <ProjectReference Include="..\MemoryPack\src\MemoryPack.Generator\MemoryPack.Generator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\SoundTouch.Net.NAudioSupport\SoundTouch.Net.NAudioSupport.csproj" />

        <ProjectReference Include="..\NFMWorld.LuaSourceGenerator\NFMWorld.LuaSourceGenerator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    </ItemGroup>

    <Import Project="../NFMWorld.ShaderSourceGen/NFMWorld.ShaderSourceGen.props" />
    
    <ItemGroup>
        <PackageReference Include="RawCef.Binaries.Windows64.Release" Version="1000.0.0-cef.151.3.14.ci.30760494954" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="RawCef.Binaries.Macosarm64.Release" Version="1000.0.0-cef.151.3.14.ci.30760494954" Condition="$([MSBuild]::IsOSPlatform('macOS'))" />
        <PackageReference Include="RawCef.Binaries.Linux64.Release" Version="1000.0.0-cef.151.3.14.ci.30760494954" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    </ItemGroup>

    <!-- Shaders to compile -->
    <ItemGroup>
        <FnaEffect Include="data\shaders\*.fx" />
    </ItemGroup>

    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SourceItemGroup" />
    </ItemGroup>

    <!-- Run mgfxc if on Windows -->
    <ItemGroup>
        <AvailableItemName Include="CompileShader" />
    </ItemGroup>

    <PropertyGroup>
        <!-- WINDOWS: -->

        <!-- 1) Use a provided tools\fxc.exe (Requires DirectX (June 2010) or the SDK) -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' == 'Windows_NT' AND Exists('$(MSBuildThisFileDirectory)tools\fxc.exe')">"$(MSBuildThisFileDirectory)tools\fxc.exe"</FxcCommandLine>

        <!-- 2) Use the SDK version (Requires DirectX SDK (June 2010)) -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' == 'Windows_NT' AND Exists('$(DXSDK_DIR)\Utilities\bin\x86\fxc.exe')">"$(DXSDK_DIR)\Utilities\bin\x86\fxc.exe"</FxcCommandLine>


        <!-- NON-WINDOWS (eg: OSX) (Requires wine is in PATH) -->

        <!-- 1) Use a provided tools/fxc.exe (Requires "winetricks d3dcompiler_43" or "winetricks dxsdk_jun2010") -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND Exists('$(MSBuildThisFileDirectory)tools\fxc.exe')">wine "$(MSBuildThisFileDirectory)tools/fxc.exe"</FxcCommandLine>

        <!-- 2) Use the SDK version (Requires "winetricks dxsdk_jun2010") -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND '$(WINEPREFIX)' != '' AND Exists('$(WINEPREFIX)/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(WINEPREFIX)/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND '$(WINEPREFIX)' != '' AND Exists('$(WINEPREFIX)/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(WINEPREFIX)/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND Exists('$(HOME)/.wine/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(HOME)/.wine/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND Exists('$(HOME)/.wine/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(HOME)/.wine/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>

    </PropertyGroup>
    <!-- Reference:
         https://stackoverflow.com/questions/3433200/msbuild-how-do-i-create-and-use-a-task-to-convert-content-items-at-build-time

         Handy reload solution: https://stackoverflow.com/a/24837585/165500
    -->
    <Target Name="BuildShaders" BeforeTargets="Compile" Inputs="@(CompileShader)" Outputs="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )">

        <Error Text="Unable to find fxc.exe. Install DirectX SDK (June 2010). See the documentation for more details." Condition="'$(FxcCommandLine)' == '' AND '$(OS)' == 'Windows_NT'" />
        <Error Text="Unable to find fxc.exe. Install DirectX SDK (June 2010) using 'winetricks dxsdk_jun2010'. See the documentation for more details." Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT'" />

        <!-- fxc doesn't know how to create directories: -->
        <MakeDir Directories="$(OutputPath)%(CompileShader.RelativeDir)" />

        <Exec Command="$(FxcCommandLine) /nologo /Vd /T fx_2_0 /Fo &quot;$(OutputPath)%(CompileShader.RelativeDir)%(CompileShader.Filename).fxb&quot; &quot;%(CompileShader.Identity)&quot;" />

        <Message Text="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )" Importance="High" />

        <!-- Add to the cleaning list, so we know how to do rebuilds:
             (NOTE: FileWrites gets written out to obj directory at some point, possbily after CoreCompile)
        -->
        <ItemGroup>
            <FileWrites Include="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )" />
        </ItemGroup>
    </Target>


    <!-- Ensure that dependent projects are aware of generated shaders:

         Reference: https://stackoverflow.com/questions/14322391/msbuild-to-copy-dynamically-generated-files-as-part-of-project-dependency
         Also: https://stackoverflow.com/questions/44752139/how-to-make-msbuild-correctly-track-files-generated-with-an-external-tool-across
    -->
    <Target Name="IncludeShaders" BeforeTargets="GetCopyToOutputDirectoryItems">
        <ItemGroup>
            <CompiledShaders Include="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <TargetPath>%(RelativeDir)%(FileName).fxb</TargetPath>
            </CompiledShaders>
            <AllItemsFullPathWithTargetPath Include="@(CompiledShaders->'%(FullPath)')" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <CompileShader Include="data/shaders/*.fx" />
    </ItemGroup>

    <!-- ── Web UI (Vite + Preact) Build ────────────────────────────── -->
    <!-- On Release builds, run pnpm install + pnpm run build to produce -->
    <!-- the production bundles. On Debug, use the Vite dev server instead -->
    <!-- (run `pnpm run dev` in data/html/ alongside `dotnet run`).       -->

    <!-- output memorypack TypeScript code to directory -->
    <ItemGroup>
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptOutputDirectory" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptImportExtension" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptConvertPropertyName" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptEnableNullableTypes" />
    </ItemGroup>
    <PropertyGroup>
        <MemoryPackGenerator_TypeScriptOutputDirectory>$(MSBuildProjectDirectory)\data\html\src\shared\memorypack</MemoryPackGenerator_TypeScriptOutputDirectory>
        <MemoryPackGenerator_TypeScriptEnableNullableTypes>true</MemoryPackGenerator_TypeScriptEnableNullableTypes>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="data\html\src\shared\memorypack\" />
        <Folder Include="Mad\Renderer\Renderable\" />
    </ItemGroup>


    <Target Name="CopyShadersOnPublish" AfterTargets="Publish">
        <ItemGroup>
            <ShaderFiles Include="$(OutputPath)/data/shaders/*.fxb" />
        </ItemGroup>
        <Copy SourceFiles="@(ShaderFiles)" DestinationFolder="$(PublishDir)/data/shaders" />
    </Target>

    <!-- LuaCATS definition file output -->
    <ItemGroup>
        <CompilerVisibleProperty Include="LuaSourceGenerator_LuaCATSOutputDirectory" />
        <CompilerVisibleProperty Include="LuaVisibleGenerator_StubsOutputDirectory" />
    </ItemGroup>
    <PropertyGroup>
        <LuaSourceGenerator_LuaCATSOutputDirectory>$(MSBuildProjectDirectory)\..\NFMWorld.Library\data\library\declarations</LuaSourceGenerator_LuaCATSOutputDirectory>
        <LuaVisibleGenerator_StubsOutputDirectory>$(MSBuildProjectDirectory)\..\NFMWorld.Library\data\library\declarations</LuaVisibleGenerator_StubsOutputDirectory>
    </PropertyGroup>
</Project>
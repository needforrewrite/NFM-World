<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>nfm_world</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>USE_BASS</DefineConstants>
    <Version>0.0.0-dev</Version>
    <InformationalVersion>NFM-World dev</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <TieredCompilation>false</TieredCompilation>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!--    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
    <!--    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>-->
  </PropertyGroup>
<!--
    <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>
-->
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico"/>
        <None Remove="Icon.bmp"/>
        <None Update="steam_appid.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
            <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
            <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9"/>
        <PackageReference Include="ManagedBass" Version="4.0.1"/>
        <PackageReference Include="ManagedBass.Fx" Version="4.0.1"/>
        <PackageReference Include="StbImageSharp" Version="2.30.15"/>
        <None Include="data\**\*" CopyToOutputDirectory="PreserveNewest"/>
        <PackageReference Include="ManagedBass.Opus" Version="4.0.1"/>
        <PackageReference Include="Yoga-CS" Version="1.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\HoleyDiver\HoleyDiver.csproj"/>
        <ProjectReference Include="..\FNA.Math\FNA.Math.csproj"/>
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions\Maxine.Extensions.csproj"/>
        <ProjectReference Include="..\Maxine.Extensions\RayTech.RayLog.MEL\RayTech.RayLog.MEL.csproj" />
        <ProjectReference Include="..\MonoGame.ImGuiNet\MonoGame.ImGuiNet.MoonWorks\MonoGame.ImGuiNet.MoonWorks.csproj"/>
        <ProjectReference Include="..\NvgSharp\src\MoonWorks\NvgSharp.MoonWorks.csproj"/>
        <ProjectReference Include="..\NvgSharp\src\NvgSharp.Text\NvgSharp.Text.MoonWorks.csproj"/>
        <ProjectReference Include="..\FontStashSharp\src\MoonWorks\FontStashSharp.MoonWorks.csproj"/>
        <ProjectReference Include="..\MoonWorks\MoonWorks.csproj"/>
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj"/>
        <ProjectReference Include="..\NFMWorld.XamlX.Core\NFMWorld.XamlX.Core.csproj"/>
        <ProjectReference Include="..\XamlX\src\XamlX.Runtime\XamlX.Runtime.csproj"/>
        <!-- Reference Avalonia.Generators for XAML source generation -->
        <ProjectReference Include="..\Avalonia.Generators\Avalonia.Generators.csproj"
                          PrivateAssets="all"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
        />
        <ProjectReference Include="..\XamlX\src\XamlX\XamlX.csproj"/>
    </ItemGroup>

    <!-- XAML compilation for Yoga UI -->
    <PropertyGroup>
        <NFMWorldXamlXTasksDir Condition="'$(NFMWorldXamlXTasksDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\NFMWorld.XamlX.BuildTask\bin\$(Configuration)\net10.0\NFMWorld.XamlX.BuildTask.dll')">$(MSBuildThisFileDirectory)..\NFMWorld.XamlX.BuildTask\bin\$(Configuration)\net10.0\</NFMWorldXamlXTasksDir>
        <NFMWorldXamlXTasksDir Condition="'$(NFMWorldXamlXTasksDir)' == '' AND Exists('$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\NFMWorld.XamlX.BuildTask.dll')">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0\</NFMWorldXamlXTasksDir>
        <NFMWorldXamlXTasksDir Condition="'$(NFMWorldXamlXTasksDir)' == '' AND Exists('$(MSBuildThisFileDirectory)bin\Debug\net10.0\NFMWorld.XamlX.BuildTask.dll')">$(MSBuildThisFileDirectory)..\bin\Debug\net10.0\</NFMWorldXamlXTasksDir>
        <NFMWorldXamlXTasksDir Condition="'$(NFMWorldXamlXTasksDir)' == '' AND Exists('$(MSBuildThisFileDirectory)bin\Release\net10.0\NFMWorld.XamlX.BuildTask.dll')">$(MSBuildThisFileDirectory)..\bin\Release\net10.0\</NFMWorldXamlXTasksDir>

        <!-- Fallback for CI and people who are too lazy to build the task first -->
        <NFMWorldXamlXTasksDir Condition="'$(NFMWorldXamlXTasksDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\NFMWorld.XamlX.BuildTask\prebuilt\NFMWorld.XamlX.BuildTask.dll')">$(MSBuildThisFileDirectory)..\NFMWorld.XamlX.BuildTask\prebuilt\</NFMWorldXamlXTasksDir>
    </PropertyGroup>

    <!-- Import the XAML build targets (only if the task is built) -->
    <Import Project="..\NFMWorld.XamlX.BuildTask\build\NFMWorld.XamlX.BuildTask.targets"
            Condition="Exists('..\NFMWorld.XamlX.BuildTask\build\NFMWorld.XamlX.BuildTask.targets')"/>

    <!-- rd.xml file for runtime directive preservation -->
    <ItemGroup>
        <RdXmlFile Include="rd.xml"/>
    </ItemGroup>

    <!-- XAML files to compile -->
    <ItemGroup>
        <AvaloniaXaml Include="mad\ui\hud\CentralTextView.xaml"/>
        <AvaloniaXaml Include="mad\ui\hud\LapTimerSplitsView.xaml"/>
        <AvaloniaXaml Include="mad\ui\hud\PowerDamageBars.xaml"/>
        <AvaloniaXaml Include="mad\ui\hud\TTLapTimerSplitsView.xaml"/>
        <AvaloniaXaml Include="mad\ui\menu\GarageUiView.xaml"/>
    </ItemGroup>

    <!-- https://platform.uno/blog/using-msbuild-items-and-properties-in-c-9-source-generators/ -->
    <Target Name="_InjectAdditionalFiles" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
        <ItemGroup>
            <AdditionalFiles Include="@(AvaloniaXaml)" SourceItemGroup="AvaloniaXaml"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SourceItemGroup"/>
    </ItemGroup>

    <!-- windows builds -->
    <Target Name="CopyCustomContentWindows" AfterTargets="AfterBuild" Condition="'$(OS)' == 'Windows_NT'">
        <ItemGroup>
            <DllFiles Include="skiadriver/*.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(DllFiles)" DestinationFolder="$(OutDir)"/>
    </Target>

    <Target Name="CopyCustomContentWindows_Publish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
        <ItemGroup>
            <DllFiles Include="skiadriver/*.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(DllFiles)" DestinationFolder="$(PublishDir)"/>
    </Target>

    <!-- linux builds -->
    <Target Name="CopyCustomContentLinux" AfterTargets="AfterBuild" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <ItemGroup>
            <SoFiles Include="skiadriver/*.so"/>
            <SoFiles Include="skiadriver/*.so.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(SoFiles)" DestinationFolder="$(OutDir)"/>
    </Target>

    <Target Name="CopyCustomContentLinux_Publish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <ItemGroup>
            <SoFiles Include="skiadriver/*.so"/>
            <SoFiles Include="skiadriver/*.so.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(SoFiles)" DestinationFolder="$(PublishDir)"/>
    </Target>

    <!-- mac builds -->
    <Target Name="CopyCustomContentLinux" AfterTargets="AfterBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <ItemGroup>
            <DylibFiles Include="skiadriver/*.dylib"/>
        </ItemGroup>
        <Copy SourceFiles="@(DylibFiles)" DestinationFolder="$(OutDir)"/>
    </Target>

    <Target Name="CopyCustomContentLinux_Publish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <ItemGroup>
            <DylibFiles Include="skiadriver/*.dylib"/>
        </ItemGroup>
        <Copy SourceFiles="@(DylibFiles)" DestinationFolder="$(PublishDir)"/>
    </Target>

    <!-- Shaders: HLSL files are loaded at runtime via MoonWorks ShaderCross (HLSL → SPIRV → native).
         The .hlsl and .hlsli files in data/shaders/ are copied to output by the data\**\* glob above.
         No build-time shader compilation is needed. -->


    <ItemGroup>
        <Compile Update="mad\ui\hud\CentralTextView.cs">
            <DependentUpon>CentralTextView.xaml</DependentUpon>
        </Compile>
        <Compile Update="mad\ui\hud\LapTimerSplitsView.cs">
            <DependentUpon>LapTimerSplitsView.xaml</DependentUpon>
        </Compile>
        <Compile Update="mad\ui\hud\PowerDamageBars.cs">
            <DependentUpon>PowerDamageBars.xaml</DependentUpon>
        </Compile>
        <Compile Update="mad\ui\hud\TTLapTimerSplitsView.cs">
            <DependentUpon>TTLapTimerSplitsView.xaml</DependentUpon>
        </Compile>
        <Compile Update="mad\ui\menu\GarageUiView.cs">
            <DependentUpon>GarageUiView.xaml</DependentUpon>
        </Compile>
    </ItemGroup>


    <ItemGroup>
      <Folder Include="mad\renderer\renderable\" />
    </ItemGroup>

    <!-- Shader HLSL source files are deployed to output via data\**\* and loaded at runtime by ShaderCross -->
</Project>
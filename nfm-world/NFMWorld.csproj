<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>NFMWorld</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>USE_BASS;USE_FAUDIO</DefineConstants>
        <Version>0.0.0-dev</Version>
        <InformationalVersion>NFM-World dev</InformationalVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <TieredCompilation>false</TieredCompilation>
        <OptimizationPreference>Speed</OptimizationPreference>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <!-- Exclude emitted source-generator files from implicit *.cs glob to prevent double compilation -->
        <Compile Remove="Generated/**" />
  </ItemGroup>
<!--
    <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>
-->
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <PropertyGroup>
        <UseCefGlueArm64Package Condition="'$(RuntimeIdentifier)' != ''">$([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-arm64'))</UseCefGlueArm64Package>
        <UseCefGlueArm64Package Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">true</UseCefGlueArm64Package>
        <UseCefGlueArm64Package Condition="'$(UseCefGlueArm64Package)' == '' and '$(RuntimeIdentifier)' == '' and '$(Platform)' != 'x64'">$([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').EndsWith('-arm64'))</UseCefGlueArm64Package>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />
        <None Update="steam_appid.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
            <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
            <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Collections.Pooled" Version="2.0.0-preview.27" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
        <PackageReference Include="LibOpenMPT.NET" Version="0.8.6" />
        <PackageReference Include="ManagedBass" Version="4.0.1" />
        <PackageReference Include="ManagedBass.Fx" Version="4.0.1" />
        <None Include="data\**\*" CopyToOutputDirectory="Always" />
        <None Remove="data\html\node_modules\**" CopyToOutputDirectory="Never" />
        <None Remove="data\html\dist\**" CopyToOutputDirectory="Never" />
        <PackageReference Include="ManagedBass.Opus" Version="4.0.1" />
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
        <PackageReference Include="NAudio" Version="3.0.0-preview.18" />
        <PackageReference Include="NAudio.SoundFile" Version="3.0.0-preview.18" />
        <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
        <PackageReference Include="NLayer" Version="2.0.1" />
        <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
        <PackageReference Include="NVorbis" Version="1.0.0-rc.2" />
        <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
        <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
        <PackageReference Include="System.Reactive" Version="7.0.0-rc.1" />
        <PackageReference Include="CefGlue.Common" Version="120.6099.211" Condition="'$(UseCefGlueArm64Package)' != 'true'" />
        <PackageReference Include="CefGlue.Common.ARM64" Version="120.6099.211" Condition="'$(UseCefGlueArm64Package)' == 'true'" />
        <PackageReference Include="Yoga-CS" Version="1.0.0" />
    </ItemGroup>
    <!--
         Prevent CefGlue.Common NuGet from copying its bundled self-contained browser process
         (Xilium.CefGlue.BrowserProcess.exe + entire .NET runtime) to output/publish.
         NFMWorld.BrowserProcess.exe already compiles all CefGlue.BrowserProcess source via ProjectReference.
    -->
    <ItemGroup>
        <CefGlueBrowserProcessFiles Remove="@(CefGlueBrowserProcessFiles)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\HoleyDiver\HoleyDiver.csproj" />
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions\Maxine.Extensions.csproj" />
        <ProjectReference Include="..\Maxine.Extensions\RayTech.RayLog.MEL\RayTech.RayLog.MEL.csproj" />
        <ProjectReference Include="..\MonoGame.ImGuiNet\MonoGame.ImGuiNet\Monogame.ImGuiNet.csproj" />
        <ProjectReference Include="..\NAudio.Flac\NAudio.Flac\NAudio.Flac.csproj" />
        <ProjectReference Include="..\NFMWorld.Api\NFMWorld.Api.csproj" />
        <ProjectReference Include="..\NFMWorld.BrowserProcess\NFMWorld.BrowserProcess.csproj" />
        <ProjectReference Include="..\NFMWorld.Library\NFMWorld.Library.csproj" />
        <ProjectReference Include="..\NFMWorld.Multiplayer.Base\NFMWorld.Multiplayer.Base.csproj" />
        <ProjectReference Include="..\NFMWorld.NativeLibs\NFMWorld.NativeLibs.csproj" />
        <ProjectReference Include="..\NvgSharp\src\NvgSharp.Text\NvgSharp.Text.FNA.Core.csproj" />
        <ProjectReference Include="..\NvgSharp\src\XNA\NvgSharp.FNA.Core.csproj" />

        <!-- Reference NFMWorld.ShaderSourceGen for XAML source generation -->
        <ProjectReference Include="..\NFMWorld.ShaderSourceGen\NFMWorld.ShaderSourceGen.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.UnionGen\Maxine.Extensions.UnionGen.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\Maxine.Extensions\Maxine.Extensions.UnionGen.Base\Maxine.Extensions.UnionGen.Base.csproj" />

        <ProjectReference Include="..\MemoryPack\src\MemoryPack.Generator\MemoryPack.Generator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
        <ProjectReference Include="..\SoundTouch.Net.NAudioSupport\SoundTouch.Net.NAudioSupport.csproj" />
    </ItemGroup>

    <Import Project="../NFMWorld.ShaderSourceGen/NFMWorld.ShaderSourceGen.props" />

    <Target Name="EnsureCefGlueMacRuntimeLibrariesInOutDir" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory" Condition="'$(CefGlueTargetPlatform)' == 'osx-x64' or '$(CefGlueTargetPlatform)' == 'osx-arm64'">
        <ItemGroup>
            <_CefMacRuntimeLibraries Include="@(CefRedistOSX64)" Condition="'$(CefGlueTargetPlatform)' == 'osx-x64' and ('%(Filename)%(Extension)' == 'libEGL.dylib' or '%(Filename)%(Extension)' == 'libGLESv2.dylib' or '%(Filename)%(Extension)' == 'libvk_swiftshader.dylib')" />
            <_CefMacRuntimeLibraries Include="@(CefRedistOSXARM64)" Condition="'$(CefGlueTargetPlatform)' == 'osx-arm64' and ('%(Filename)%(Extension)' == 'libEGL.dylib' or '%(Filename)%(Extension)' == 'libGLESv2.dylib' or '%(Filename)%(Extension)' == 'libvk_swiftshader.dylib')" />
            <_CefMacRuntimeLibrariesToCopy Include="@(_CefMacRuntimeLibraries)" Condition="!Exists('$(OutDir)%(Filename)%(Extension)')" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefMacRuntimeLibrariesToCopy)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_CefMacRuntimeLibrariesToCopy)' != ''" />
    </Target>

    <!--
         Redirect CEF NuGet assets to the correct output layout:
         - Native shared libs (.dll/.so/.dylib) -&gt; output root (alongside NFMWorld.BrowserProcess)
         - Resources (.pak/.dat/.bin/.json)    -&gt; data/cef/
         - Locales (locale .pak files)          -&gt; data/cef/locales/

         Runs after CefGlue.Common.targets' ResolveCEFAssets (which creates None items
         for Windows CEF runtime/locale files) and before the SDK's CopyFilesToOutputDirectory.
         Does NOT patch any NuGet package files.
    -->
    <Target Name="RedirectCefAssetsToDataCef" AfterTargets="ResolveCEFAssets" BeforeTargets="CopyFilesToOutputDirectory;PrepareForPublish">
        <ItemGroup>
            <!-- (a) Windows runtime items: have NuGetPackageId from RuntimeTargetsCopyLocalItems.
                 Check None AND ReferenceCopyLocalPaths. The .NET SDK puts native runtime files
                 in both: None items go to output root (via CefGlue.Common.targets), while
                 ReferenceCopyLocalPaths items go to runtimes\{rid}\native\ (via SDK targets). -->
            <_CefByPackage Include="@(None)"
                           Condition="$([System.String]::new('%(None.NuGetPackageId)').StartsWith('chromiumembeddedframework.runtime.'))" />
            <_CefByPackage Include="@(ReferenceCopyLocalPaths)"
                           Condition="$([System.String]::new('%(ReferenceCopyLocalPaths.NuGetPackageId)').StartsWith('chromiumembeddedframework.runtime.'))" />

            <!-- (b) Linux / macOS dylib-in-CefGlueBrowserProcess items: Link contains CefGlueBrowserProcess -->
            <_CefByBpDir Include="@(None)"
                         Condition="$([System.String]::new('%(None.Link)').Contains('CefGlueBrowserProcess'))" />

            <!-- (c) Windows locale items: Link under runtimes\...\locales\, .pak extension, no NuGetPackageId -->
            <_CefWinLocales Include="@(None)"
                            Condition="'%(None.Extension)' == '.pak'
                                       AND $([System.String]::new('%(None.Link)').Contains('runtimes'))
                                       AND $([System.String]::new('%(None.Link)').Contains('locales'))" />

            <!-- (d) macOS / Linux redist items: identified by source path containing 'cef.redist.'
                 (CefRedistOSX64 / CefRedistLinux64). These items lack NuGetPackageId and their
                 Link does NOT contain CefGlueBrowserProcess. Contains('cef.redist.') is safe
                 because the search term has no C# escape sequences. Also catches Linux redist
                 items as a fallback. -->
            <_CefRedist Include="@(None)"
                        Condition="$([System.String]::new('%(FullPath)').Contains('cef.redist.'))" />
        </ItemGroup>

        <!-- Merge, deduplicating items caught by multiple filters -->
        <ItemGroup>
            <_CefAll Include="@(_CefByPackage)" />
            <_CefAll Include="@(_CefByBpDir)"   Exclude="@(_CefByPackage)" />
            <_CefAll Include="@(_CefWinLocales)" Exclude="@(_CefByPackage);@(_CefByBpDir)" />
            <_CefAll Include="@(_CefRedist)"     Exclude="@(_CefByPackage);@(_CefByBpDir);@(_CefWinLocales)" />
        </ItemGroup>

        <!-- Split into three destination categories -->
        <ItemGroup>
            <!-- Native shared libraries -> output root (flat) -->
            <_CefNative Include="@(_CefAll)"
                        Condition="'%(_CefAll.Extension)' == '.dll'
                                   OR '%(_CefAll.Extension)' == '.so'
                                   OR '%(_CefAll.Extension)' == '.dylib'" />

            <!-- Locale .pak files -> data\cef\locales\ -->
            <_CefLocales Include="@(_CefAll)"
                         Condition="'%(_CefAll.Extension)' == '.pak'
                                    AND $([System.String]::new('%(FullPath)').Contains('locales'))" />

            <!-- Everything else (non-locale .pak, .dat, .bin, .json) -> data\cef\ -->
            <_CefResources Include="@(_CefAll)" Exclude="@(_CefNative);@(_CefLocales)" />
        </ItemGroup>

        <!-- Remove originals from None, ReferenceCopyLocalPaths, and ResolvedFileToPublish -->
        <ItemGroup>
            <None Remove="@(_CefAll)" />
            <ReferenceCopyLocalPaths Remove="@(_CefAll)" />
            <ResolvedFileToPublish Remove="@(_CefAll)" />
        </ItemGroup>

        <!-- Re-add native libs to output root -->
        <ItemGroup Condition="'@(_CefNative)' != ''">
            <None Include="@(_CefNative)">
                <Link>%(_CefNative.FileName)%(_CefNative.Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
                <Visible>false</Visible>
            </None>
        </ItemGroup>

        <!-- Re-add resources to data\cef\ -->
        <ItemGroup Condition="'@(_CefResources)' != ''">
            <None Include="@(_CefResources)">
                <Link>data\cef\%(_CefResources.FileName)%(_CefResources.Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
                <Visible>false</Visible>
            </None>
        </ItemGroup>

        <!-- Re-add locales to data\cef\locales\ -->
        <ItemGroup Condition="'@(_CefLocales)' != ''">
            <None Include="@(_CefLocales)">
                <Link>data\cef\locales\%(_CefLocales.FileName)%(_CefLocales.Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <PublishState>Included</PublishState>
                <Visible>false</Visible>
            </None>
        </ItemGroup>
    </Target>

    <!--
         Post-copy cleanup: remove CEF duplicates from three locations:
         1. runtimes\{rid}\native\  - .NET SDK native runtime copies (Windows)
         2. CefGlueBrowserProcess\     - CefGlue.Common.targets static copies (Linux/macOS)
         3. Resources\                 - macOS CEF resource bundle

         Our RedirectCefAssetsToDataCef target prevents new copies to these locations,
         but stale files from prior builds and publish may persist. This target deletes them.
         Runs after both build and publish output copy steps.
    -->
    <Target Name="CleanupCefDuplicates" AfterTargets="CopyFilesToOutputDirectory;Publish">
        <PropertyGroup>
            <_CefCleanupRuntimes>$([System.IO.Path]::GetFullPath('$(OutDir)runtimes'))</_CefCleanupRuntimes>
            <_CefCleanupBp>$([System.IO.Path]::GetFullPath('$(OutDir)CefGlueBrowserProcess'))</_CefCleanupBp>
            <_CefCleanupResources>$([System.IO.Path]::GetFullPath('$(OutDir)Resources'))</_CefCleanupResources>
            <!-- Also clean publish output dir if publishing -->
            <_CefCleanupRuntimesPub Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir)runtimes'))</_CefCleanupRuntimesPub>
            <_CefCleanupBpPub Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir)CefGlueBrowserProcess'))</_CefCleanupBpPub>
            <_CefCleanupResourcesPub Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir)Resources'))</_CefCleanupResourcesPub>
        </PropertyGroup>
        <!-- runtimes\ -->
        <ItemGroup>
            <_CefDupPak Include="$(_CefCleanupRuntimes)\**\*.pak" />
            <_CefDupDat Include="$(_CefCleanupRuntimes)\**\icudtl.dat" />
            <_CefDupBin Include="$(_CefCleanupRuntimes)\**\snapshot_blob.bin" />
            <_CefDupBin Include="$(_CefCleanupRuntimes)\**\v8_context_snapshot.bin" />
            <_CefDupJson Include="$(_CefCleanupRuntimes)\**\vk_swiftshader_icd.json" />
            <_CefDupDll Include="$(_CefCleanupRuntimes)\**\libcef.*" />
            <_CefDupDll Include="$(_CefCleanupRuntimes)\**\chrome_elf.*" />
            <_CefDupDll Include="$(_CefCleanupRuntimes)\**\libEGL.*" />
            <_CefDupDll Include="$(_CefCleanupRuntimes)\**\libGLESv2.*" />
            <_CefDupDll Include="$(_CefCleanupRuntimes)\**\vk_swiftshader.*" />
            <_CefDupDll Include="$(_CefCleanupRuntimes)\**\vulkan-1.*" />
            <_CefDupDll Include="$(_CefCleanupRuntimes)\**\d3dcompiler_47.*" />
        </ItemGroup>
        <Delete Files="@(_CefDupPak);@(_CefDupDat);@(_CefDupBin);@(_CefDupJson);@(_CefDupDll)" />
        <!-- Build output root: stale CEF resource files that were placed here before
             RedirectCefAssetsToDataCef was added, or that get copied by the SDK
             pipeline before our target can intercept them. Native DLLs stay. -->
        <ItemGroup>
            <_CefRootPak Include="$(OutDir)chrome_100_percent.pak" />
            <_CefRootPak Include="$(OutDir)chrome_200_percent.pak" />
            <_CefRootPak Include="$(OutDir)resources.pak" />
            <_CefRootDat Include="$(OutDir)icudtl.dat" />
            <_CefRootBin Include="$(OutDir)snapshot_blob.bin" />
            <_CefRootBin Include="$(OutDir)v8_context_snapshot.bin" />
            <_CefRootJson Include="$(OutDir)vk_swiftshader_icd.json" />
        </ItemGroup>
        <Delete Files="@(_CefRootPak);@(_CefRootDat);@(_CefRootBin);@(_CefRootJson)" />
        <!-- CefGlueBrowserProcess\ -->
        <ItemGroup>
            <_CefBpPak Include="$(_CefCleanupBp)\**\*.pak" />
            <_CefBpDat Include="$(_CefCleanupBp)\**\icudtl.dat" />
            <_CefBpBin Include="$(_CefCleanupBp)\**\snapshot_blob.bin" />
            <_CefBpBin Include="$(_CefCleanupBp)\**\v8_context_snapshot.bin" />
            <_CefBpJson Include="$(_CefCleanupBp)\**\vk_swiftshader_icd.json" />
            <_CefBpDll Include="$(_CefCleanupBp)\**\libcef.*" />
            <_CefBpDll Include="$(_CefCleanupBp)\**\chrome_elf.*" />
            <_CefBpDll Include="$(_CefCleanupBp)\**\libEGL.*" />
            <_CefBpDll Include="$(_CefCleanupBp)\**\libGLESv2.*" />
            <_CefBpDll Include="$(_CefCleanupBp)\**\vk_swiftshader.*" />
            <_CefBpDll Include="$(_CefCleanupBp)\**\vulkan-1.*" />
            <_CefBpDll Include="$(_CefCleanupBp)\**\d3dcompiler_47.*" />
        </ItemGroup>
        <Delete Files="@(_CefBpPak);@(_CefBpDat);@(_CefBpBin);@(_CefBpJson);@(_CefBpDll)" />
        <RemoveDir Directories="$(_CefCleanupBp)" Condition="Exists('$(_CefCleanupBp)')" />
        <!-- Resources\ (macOS) -->
        <ItemGroup>
            <_CefResPak Include="$(_CefCleanupResources)\**\*.pak" />
            <_CefResDat Include="$(_CefCleanupResources)\**\icudtl.dat" />
            <_CefResBin Include="$(_CefCleanupResources)\**\snapshot_blob.bin" />
            <_CefResBin Include="$(_CefCleanupResources)\**\v8_context_snapshot.bin" />
            <_CefResJson Include="$(_CefCleanupResources)\**\vk_swiftshader_icd.json" />
        </ItemGroup>
        <Delete Files="@(_CefResPak);@(_CefResDat);@(_CefResBin);@(_CefResJson)" />
        <RemoveDir Directories="$(_CefCleanupResources)" Condition="Exists('$(_CefCleanupResources)')" />
        <!-- Publish dir: runtimes\ -->
        <ItemGroup Condition="'$(PublishDir)' != ''">
            <_CefPubPak Include="$(_CefCleanupRuntimesPub)\**\*.pak" />
            <_CefPubDat Include="$(_CefCleanupRuntimesPub)\**\icudtl.dat" />
            <_CefPubBin Include="$(_CefCleanupRuntimesPub)\**\snapshot_blob.bin" />
            <_CefPubBin Include="$(_CefCleanupRuntimesPub)\**\v8_context_snapshot.bin" />
            <_CefPubJson Include="$(_CefCleanupRuntimesPub)\**\vk_swiftshader_icd.json" />
            <_CefPubDll Include="$(_CefCleanupRuntimesPub)\**\libcef.*" />
            <_CefPubDll Include="$(_CefCleanupRuntimesPub)\**\chrome_elf.*" />
            <_CefPubDll Include="$(_CefCleanupRuntimesPub)\**\libEGL.*" />
            <_CefPubDll Include="$(_CefCleanupRuntimesPub)\**\libGLESv2.*" />
            <_CefPubDll Include="$(_CefCleanupRuntimesPub)\**\vk_swiftshader.*" />
            <_CefPubDll Include="$(_CefCleanupRuntimesPub)\**\vulkan-1.*" />
            <_CefPubDll Include="$(_CefCleanupRuntimesPub)\**\d3dcompiler_47.*" />
        </ItemGroup>
        <Delete Files="@(_CefPubPak);@(_CefPubDat);@(_CefPubBin);@(_CefPubJson);@(_CefPubDll)" Condition="'$(PublishDir)' != ''" />
        <!-- Publish dir root: CEF resources dumped directly in publish root by SDK pipeline -->
        <ItemGroup Condition="'$(PublishDir)' != ''">
            <_CefPubRootPak Include="$(PublishDir)chrome_100_percent.pak" />
            <_CefPubRootPak Include="$(PublishDir)chrome_200_percent.pak" />
            <_CefPubRootPak Include="$(PublishDir)resources.pak" />
            <_CefPubRootDat Include="$(PublishDir)icudtl.dat" />
            <_CefPubRootBin Include="$(PublishDir)snapshot_blob.bin" />
            <_CefPubRootBin Include="$(PublishDir)v8_context_snapshot.bin" />
            <_CefPubRootJson Include="$(PublishDir)vk_swiftshader_icd.json" />
        </ItemGroup>
        <Delete Files="@(_CefPubRootPak);@(_CefPubRootDat);@(_CefPubRootBin);@(_CefPubRootJson)" Condition="'$(PublishDir)' != ''" />
        <!-- Publish dir: CefGlueBrowserProcess\ -->
        <ItemGroup Condition="'$(PublishDir)' != ''">
            <_CefPubBpPak Include="$(_CefCleanupBpPub)\**\*.pak" />
            <_CefPubBpDat Include="$(_CefCleanupBpPub)\**\icudtl.dat" />
            <_CefPubBpBin Include="$(_CefCleanupBpPub)\**\snapshot_blob.bin" />
            <_CefPubBpBin Include="$(_CefCleanupBpPub)\**\v8_context_snapshot.bin" />
            <_CefPubBpJson Include="$(_CefCleanupBpPub)\**\vk_swiftshader_icd.json" />
            <_CefPubBpDll Include="$(_CefCleanupBpPub)\**\libcef.*" />
            <_CefPubBpDll Include="$(_CefCleanupBpPub)\**\chrome_elf.*" />
            <_CefPubBpDll Include="$(_CefCleanupBpPub)\**\libEGL.*" />
            <_CefPubBpDll Include="$(_CefCleanupBpPub)\**\libGLESv2.*" />
            <_CefPubBpDll Include="$(_CefCleanupBpPub)\**\vk_swiftshader.*" />
            <_CefPubBpDll Include="$(_CefCleanupBpPub)\**\vulkan-1.*" />
            <_CefPubBpDll Include="$(_CefCleanupBpPub)\**\d3dcompiler_47.*" />
        </ItemGroup>
        <Delete Files="@(_CefPubBpPak);@(_CefPubBpDat);@(_CefPubBpBin);@(_CefPubBpJson);@(_CefPubBpDll)" Condition="'$(PublishDir)' != ''" />
        <RemoveDir Directories="$(_CefCleanupBpPub)" Condition="'$(PublishDir)' != '' and Exists('$(_CefCleanupBpPub)')" />
        <!-- Publish dir: Resources\ (macOS) -->
        <ItemGroup Condition="'$(PublishDir)' != ''">
            <_CefPubResPak Include="$(_CefCleanupResourcesPub)\**\*.pak" />
            <_CefPubResDat Include="$(_CefCleanupResourcesPub)\**\icudtl.dat" />
            <_CefPubResBin Include="$(_CefCleanupResourcesPub)\**\snapshot_blob.bin" />
            <_CefPubResBin Include="$(_CefCleanupResourcesPub)\**\v8_context_snapshot.bin" />
            <_CefPubResJson Include="$(_CefCleanupResourcesPub)\**\vk_swiftshader_icd.json" />
        </ItemGroup>
        <Delete Files="@(_CefPubResPak);@(_CefPubResDat);@(_CefPubResBin);@(_CefPubResJson)" Condition="'$(PublishDir)' != ''" />
        <RemoveDir Directories="$(_CefCleanupResourcesPub)" Condition="'$(PublishDir)' != '' and Exists('$(_CefCleanupResourcesPub)')" />
    </Target>

    <!-- XAML files to compile -->

    <!-- Shaders to compile -->
    <ItemGroup>
        <FnaEffect Include="data\shaders\*.fx" />
    </ItemGroup>

    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SourceItemGroup" />
    </ItemGroup>

    <!-- Run mgfxc if on Windows -->
    <ItemGroup>
        <AvailableItemName Include="CompileShader" />
    </ItemGroup>

    <PropertyGroup>
        <!-- WINDOWS: -->

        <!-- 1) Use a provided tools\fxc.exe (Requires DirectX (June 2010) or the SDK) -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' == 'Windows_NT' AND Exists('$(MSBuildThisFileDirectory)tools\fxc.exe')">"$(MSBuildThisFileDirectory)tools\fxc.exe"</FxcCommandLine>

        <!-- 2) Use the SDK version (Requires DirectX SDK (June 2010)) -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' == 'Windows_NT' AND Exists('$(DXSDK_DIR)\Utilities\bin\x86\fxc.exe')">"$(DXSDK_DIR)\Utilities\bin\x86\fxc.exe"</FxcCommandLine>


        <!-- NON-WINDOWS (eg: OSX) (Requires wine is in PATH) -->

        <!-- 1) Use a provided tools/fxc.exe (Requires "winetricks d3dcompiler_43" or "winetricks dxsdk_jun2010") -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND Exists('$(MSBuildThisFileDirectory)tools\fxc.exe')">wine "$(MSBuildThisFileDirectory)tools/fxc.exe"</FxcCommandLine>

        <!-- 2) Use the SDK version (Requires "winetricks dxsdk_jun2010") -->
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND '$(WINEPREFIX)' != '' AND Exists('$(WINEPREFIX)/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(WINEPREFIX)/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND '$(WINEPREFIX)' != '' AND Exists('$(WINEPREFIX)/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(WINEPREFIX)/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND Exists('$(HOME)/.wine/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(HOME)/.wine/drive_c/Program Files/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>
        <FxcCommandLine Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT' AND Exists('$(HOME)/.wine/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe')">wine "$(HOME)/.wine/drive_c/Program Files (x86)/Microsoft DirectX SDK (June 2010)/Utilities/bin/x86/fxc.exe"</FxcCommandLine>

    </PropertyGroup>
    <!-- Reference:
         https://stackoverflow.com/questions/3433200/msbuild-how-do-i-create-and-use-a-task-to-convert-content-items-at-build-time

         Handy reload solution: https://stackoverflow.com/a/24837585/165500
    -->
    <Target Name="BuildShaders" BeforeTargets="Compile" Inputs="@(CompileShader)" Outputs="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )">

        <Error Text="Unable to find fxc.exe. Install DirectX SDK (June 2010). See the documentation for more details." Condition="'$(FxcCommandLine)' == '' AND '$(OS)' == 'Windows_NT'" />
        <Error Text="Unable to find fxc.exe. Install DirectX SDK (June 2010) using 'winetricks dxsdk_jun2010'. See the documentation for more details." Condition="'$(FxcCommandLine)' == '' AND '$(OS)' != 'Windows_NT'" />

        <!-- fxc doesn't know how to create directories: -->
        <MakeDir Directories="$(OutputPath)%(CompileShader.RelativeDir)" />

        <Exec Command="$(FxcCommandLine) /nologo /Vd /T fx_2_0 /Fo &quot;$(OutputPath)%(CompileShader.RelativeDir)%(CompileShader.Filename).fxb&quot; &quot;%(CompileShader.Identity)&quot;" />

        <Message Text="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )" Importance="High" />

        <!-- Add to the cleaning list, so we know how to do rebuilds:
             (NOTE: FileWrites gets written out to obj directory at some point, possbily after CoreCompile)
        -->
        <ItemGroup>
            <FileWrites Include="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )" />
        </ItemGroup>
    </Target>


    <!-- Ensure that dependent projects are aware of generated shaders:

         Reference: https://stackoverflow.com/questions/14322391/msbuild-to-copy-dynamically-generated-files-as-part-of-project-dependency
         Also: https://stackoverflow.com/questions/44752139/how-to-make-msbuild-correctly-track-files-generated-with-an-external-tool-across
    -->
    <Target Name="IncludeShaders" BeforeTargets="GetCopyToOutputDirectoryItems">
        <ItemGroup>
            <CompiledShaders Include="@(CompileShader -> '$(OutputPath)%(RelativeDir)%(Filename).fxb' )">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <TargetPath>%(RelativeDir)%(FileName).fxb</TargetPath>
            </CompiledShaders>
            <AllItemsFullPathWithTargetPath Include="@(CompiledShaders->'%(FullPath)')" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <CompileShader Include="data/shaders/*.fx" />
    </ItemGroup>

    <!-- ── Web UI (Vite + Preact) Build ────────────────────────────── -->
    <!-- On Release builds, run pnpm install + pnpm run build to produce -->
    <!-- the production bundles. On Debug, use the Vite dev server instead -->
    <!-- (run `pnpm run dev` in data/html/ alongside `dotnet run`).       -->

    <!-- output memorypack TypeScript code to directory -->
    <ItemGroup>
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptOutputDirectory" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptImportExtension" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptConvertPropertyName" />
        <CompilerVisibleProperty Include="MemoryPackGenerator_TypeScriptEnableNullableTypes" />
    </ItemGroup>
    <PropertyGroup>
        <MemoryPackGenerator_TypeScriptOutputDirectory>$(MSBuildProjectDirectory)\data\html\src\shared\memorypack</MemoryPackGenerator_TypeScriptOutputDirectory>
        <MemoryPackGenerator_TypeScriptEnableNullableTypes>true</MemoryPackGenerator_TypeScriptEnableNullableTypes>
    </PropertyGroup>

    <Target Name="BuildWebUi" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
        <Message Text="Building web UI (pnpm install + pnpm run build)..." Importance="High" />
        <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="data\html" />
        <Exec Command="pnpm run build" WorkingDirectory="data\html" />
    </Target>

    <Target Name="IncludeWebUi" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWebUi" Condition="Exists('data\html\dist')">
        <ItemGroup>
            <WebUiFiles Include="data\html\dist\**\*" />
            <Content Include="@(WebUiFiles)">
                <Link>data\html\dist\%(RecursiveDir)%(FileName)%(Extension)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    </Target>


    <ItemGroup>
        <Folder Include="data\html\src\shared\memorypack\" />
        <Folder Include="Mad\Renderer\Renderable\" />
    </ItemGroup>


    <Target Name="CopyShadersOnPublish" AfterTargets="Publish">
        <ItemGroup>
            <ShaderFiles Include="$(OutputPath)/data/shaders/*.fxb" />
        </ItemGroup>
        <Copy SourceFiles="@(ShaderFiles)" DestinationFolder="$(PublishDir)/data/shaders" />
    </Target>
</Project>

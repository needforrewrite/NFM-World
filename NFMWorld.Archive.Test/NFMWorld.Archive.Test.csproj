<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>NFMWorld.Archive.Test</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1"/>
        <PackageReference Include="MSTest.TestAdapter" Version="4.0.2"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.0.2"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-preview.3.26207.106"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-preview.3.26207.106"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Archive\NFMWorld.Archive.csproj"/>
        <!-- Built, not referenced: the archive runs it as a separate process, exactly as it
             does in deployment, so its own bin tree is where the tests find it. -->
        <ProjectReference Include="..\NFMWorld.Archive.Validator\NFMWorld.Archive.Validator.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>

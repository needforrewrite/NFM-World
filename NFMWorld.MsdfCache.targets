<Project>

    <!-- Bakes the fonts' MSDF atlases ahead of time, as a target any project can import.
         The game warms ~220 glyphs a font at startup and each bake costs milliseconds, which on the
         browser is most of the launch. The fields are a pure function of the font file and the bake
         constants, so they are baked here once per build and loaded instead.

         Same shape as NFMWorld.ShaderCompiler.targets, and for the same reasons: the tool is built
         from here rather than referenced, so the game never depends on the baker, and it is loaded
         out-of-process so its own build can replace it on the next run. -->

    <PropertyGroup>
        <!-- Joined with Path.Combine rather than backslash literals: these strings go
             straight into an Exec command line and a task parameter, which MSBuild does
             not normalise, so on Linux a backslashed path names a file that is not there. -->
        <NFMWorldMsdfFontsDirectory Condition="'$(NFMWorldMsdfFontsDirectory)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'nfm-world', 'data', 'fonts'))</NFMWorldMsdfFontsDirectory>
        <NFMWorldMsdfToolAssembly Condition="'$(NFMWorldMsdfToolAssembly)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'NFMWorld.MsdfCache.Tool', 'bin', '$(Configuration)', 'net11.0', 'NFMWorld.MsdfCache.Tool.dll'))</NFMWorldMsdfToolAssembly>
        <!-- The stamp records the fonts and the baker, so either changing rebakes. Kept beside the
             baking tool's own output rather than in this project's obj/: several projects import
             this file (the game, the browser head through it), and they would otherwise each keep
             their own stamp and each rebake.

             Absolute, because MSBuild resolves some of the tasks below against the process working
             directory, which under TaskHostFactory is not the project directory. -->
        <NFMWorldMsdfStamp Condition="'$(NFMWorldMsdfStamp)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'NFMWorld.MsdfCache.Tool', 'obj', '$(Configuration)', 'msdf.stamp'))</NFMWorldMsdfStamp>
    </PropertyGroup>

    <!-- Builds the tool before anything tries to run it. Unconditional for the same reason the
         shader compiler's is: the check would be against a bin/ copy, which can be newer than the
         sources without being current. The nested build is incremental on its own. -->
    <Target Name="BuildMsdfCacheTool" Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(DesignTimeBuild)' != 'true'">
        <!-- Restore first, in a separate project instance so Build imports the generated package
             paths. Nothing references this project, so no restore from the consuming project
             reaches it: without this a clean checkout fails with NETSDK1004 "assets file not
             found", which is what the desktop release builds hit on every platform. Same shape as
             NFMWorld.ShaderCompiler.targets' BuildShaderCompilerTask. -->
        <!-- NFMWorldBuildHostToolProperties clears the properties a publish leaves on the command
             line (-r, SelfContained, PublishReadyToRun, PublishSingleFile). Clear the RID alone and
             the inherited PublishReadyToRun/SelfContained are unsatisfiable (NETSDK1191); keep the
             RID and an Exe's output moves to bin/<cfg>/<tfm>/<rid>/, while NFMWorldMsdfToolAssembly
             above names the rid-less path, so the bake runs a file that is not there. The tool runs
             on the build host, not on the target RID, and is never published, so none applies.
             See Directory.Build.props.

             BuildProjectReferences=false, because those overrides are global properties: this
             nested request is then a *different project instance* of everything the tool references
             - Apos.Shapes, Graphics.Abstraction, Shaders.Abstraction, Mathematics - from the one the
             surrounding build is already compiling. MSBuild only de-duplicates identical instances,
             so both compile the same project into the same obj/ directory at once and the one that
             loses the race fails the build; the wasm publish died with a single
             "CS2012 Cannot open ... NFMWorld.Shaders.Abstraction.dll for writing" and nothing else
             in the log. The references are built by the outer graph's ResolveReferences, which is
             what BakeMsdfCaches waits for; this build only compiles the tool, and RAR still copies
             the referenced assemblies and their dependencies from their build output. -->
        <MSBuild Projects="$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'NFMWorld.MsdfCache.Tool', 'NFMWorld.MsdfCache.Tool.csproj'))"
                 Targets="Restore"
                 Properties="$(NFMWorldBuildHostToolProperties);Configuration=$(Configuration);ExcludeRestorePackageImports=true" />
        <MSBuild Projects="$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'NFMWorld.MsdfCache.Tool', 'NFMWorld.MsdfCache.Tool.csproj'))"
                 Targets="Build"
                 Properties="$(NFMWorldBuildHostToolProperties);Configuration=$(Configuration);BuildProjectReferences=false" />
    </Target>

    <!-- Bakes into the fonts directory itself, beside each font, so the output flows through the
         project's existing data/** copy rule rather than needing a copy of its own. The caches are
         therefore checked in: baking is slow, and generating them into obj/ instead would make every
         clean checkout pay the full bake before it could build at all.

         Inputs/Outputs is the fonts plus every source of the baker, because a change to the bake
         algorithm has to invalidate as much as a font edit does - and the tool's own DLL is not a
         safe stand-in for that, since a rebuild that only touched the linker would leave it looking
         unchanged. The stamp is written after the tool succeeds, so a failed bake cannot look up to
         date.

         Hooked before CoreCompile rather than PrepareForBuild because the tool builds with
         BuildProjectReferences=false and RAR needs Apos.Shapes and its chain already on disk to copy
         them into the tool's bin. ResolveReferences has run by then; nothing below that point reads
         the .msdf files, since the data/** copy happens after Compile. -->
    <ItemGroup>
        <NFMWorldMsdfFont Include="$(NFMWorldMsdfFontsDirectory)\*.ttf" />
        <NFMWorldMsdfFont Include="$(NFMWorldMsdfFontsDirectory)\*.otf" />
        <!-- Every source the bake depends on, not only the four entry points: a change to
             the glyph ranges (the tool's own Program.cs), the atlas or the table changes
             the output just as much as a change to the bake itself. -->
        <NFMWorldMsdfSource Include="$(MSBuildThisFileDirectory)Apos.Shapes\Source\Msdf*.cs" />
        <NFMWorldMsdfSource Include="$(MSBuildThisFileDirectory)Apos.Shapes\Source\Glyph*.cs" />
        <NFMWorldMsdfSource Include="$(MSBuildThisFileDirectory)Apos.Shapes\Source\ShapeFont.cs" />
        <NFMWorldMsdfSource Include="$(MSBuildThisFileDirectory)NFMWorld.MsdfCache.Tool\Program.cs" />
    </ItemGroup>

    <Target Name="BakeMsdfCaches"
            BeforeTargets="CoreCompile"
            DependsOnTargets="BuildMsdfCacheTool"
            Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(DesignTimeBuild)' != 'true'"
            Inputs="@(NFMWorldMsdfFont);@(NFMWorldMsdfSource)"
            Outputs="$(NFMWorldMsdfStamp)">

        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(NFMWorldMsdfStamp)'))" />

        <Exec Command="dotnet &quot;$(NFMWorldMsdfToolAssembly)&quot; &quot;$(NFMWorldMsdfFontsDirectory)&quot;"
              StandardOutputImportance="normal" />

        <Touch Files="$(NFMWorldMsdfStamp)" AlwaysCreate="true" />
    </Target>

</Project>

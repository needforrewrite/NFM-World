<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LuauBenchmark</RootNamespace>
    <AssemblyName>LuauBenchmark</AssemblyName>
    <!-- NFMWorld.Library sets PublishAot/NativeLib for its own AOT publishing;
         do NOT let those leak into this plain console app. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real C# UI host (LuaUiLibrary), View/Component/Yoga, DummyBackend,
         LuaVisibleTypeRegistry, and the game's Lua helpers. -->
    <ProjectReference Include="..\..\NFMWorld.Library\NFMWorld.Library.csproj" />
    <!-- The Lua VM. This is the reference that the Luau fork swaps for NuLua.Luau. -->
    <ProjectReference Include="..\..\Lua-CSharp\src\Lua\Lua.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="scripts\**\*.luau" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="TraceAnalyzer\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TraceAnalyzer\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="TraceAnalyzer\**" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Egl.cs passes attribute arrays to eglChooseConfig/eglCreateContext, and the GL command
             buffer hands raw pointers to Silk.NET for DrawElements. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- ANGLE is a native library, so it must match the process. The bindings' native package
             ships every RID, but pinning x64 keeps the build from silently producing an x86 host,
             which would be a different ANGLE (and a different set of bugs) than the one this
             backend was verified against. -->
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.OpenGLES" Version="2.23.0" />
        <PackageReference Include="Silk.NET.OpenGLES.Extensions.ANGLE" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- EGL bindings, which Silk.NET 2.x does not ship. Built over the same Khronos registry with
             the same tooling, so EGL.GetApi() returns a Silk.NET-style API object.
             A project reference rather than a PackageReference because the packages are not
             published: Maxine.Silk.EGL is checked out beside this repo and produces them on demand
             (dotnet pack). This mirrors how NFMWorld.Graphics.Sokol consumes SharpSokol, and it
             cannot go stale the way a local feed can. -->
        <ProjectReference Include="..\Maxine.Silk.EGL\src\Maxine.EGL\Maxine.EGL.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NFMWorld.Graphics.Abstraction\NFMWorld.Graphics.Abstraction.csproj" />
    </ItemGroup>

    <!-- The smoke test is the only way to verify the two things this backend's compiler work is
         for: that every reflected texture resolves to a real sampler uniform, and that the driver's
         std140 block layout matches the reflection's byte offsets. Both live on internal types
         (GlShaderProgram.TextureLocations, GlUniformBlock) and both are checked through
         GlGraphicsDevice.Gl for entry points the abstraction does not expose, such as glGetString
         and glGetError. Widening the public surface - or reaching these through reflection - would
         be worse than telling the compiler who the friend is, which is what this is for. -->
    <ItemGroup>
        <InternalsVisibleTo Include="NFMWorld.Graphics.OpenGL.Smoke" />
    </ItemGroup>

    <!-- The ANGLE natives, for every platform the bindings build them for. This reuses the native
         package's own targets rather than a PackageReference, because that project produces no
         assembly: referencing it as a package would add its (empty) lib/ folder and nothing else,
         since NuGet only imports a build/*.targets whose TFM is compatible with the consumer and
         these live under build/net461. Importing the file directly applies the same RID mapping and
         the same copy step, and it is the one place that mapping is written down.
         A ProjectReference to it does not work either - with no output assembly there is nothing for
         the reference to carry. -->
    <Import Project="..\Maxine.Silk.EGL\native\Maxine.Silk.OpenGLES.ANGLE.Native\build\net461\Maxine.Silk.OpenGLES.ANGLE.Native.targets" />

</Project>

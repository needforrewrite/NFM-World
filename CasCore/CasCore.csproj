<Project Sdk="Microsoft.NET.Sdk">

    <!-- Vendored from https://github.com/DouglasDwyer/CasCore at 488193c (MIT, see LICENSE).
         Patched in the loader: CasCore 0.3.0 refuses every `base.Method()` call, and its
         default sandbox's System.Text.Json bindings no longer match .NET 11. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>DouglasDwyer.CasCore</AssemblyName>
        <RootNamespace>DouglasDwyer.CasCore</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <NoWarn>$(NoWarn);CS0618;CS8632;IL2026;IL2070;IL2075;IL2091</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="src/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
        <PackageReference Include="DouglasDwyer.JitIlVerification" Version="0.1.4" />
    </ItemGroup>

</Project>

# Copy to .env and fill in. Never commit .env.
#
# Generate each secret with:
#   dotnet run --project NFMWorld.GenerateHmacKey            # key id "primary"
#   dotnet run --project NFMWorld.GenerateHmacKey archive    # key id "archive"
#
# There are two independent trust levels. The game master runs on machines you do not
# control, so it gets the lobby key - never the archive key, which can write ratings.

# --- Lobby <-> Game Master -------------------------------------------------
# Both halves of the same pair: the lobby signs /create-race and verifies /race-ended with it.
GM_KEY_ID=primary
GM_HMAC_SECRET=<base64 secret from NFMWorld.GenerateHmacKey>
# The same pair in the "<keyId>=<secret>" form the lobby and game master parse.
GM_HMAC_KEYS=primary=<the same base64 secret>

# --- Archive <-> Lobby -----------------------------------------------------
# The archive trust level. Only the lobby holds this.
ARCHIVE_SECRET=<base64 secret from NFMWorld.GenerateHmacKey archive>
# Same pair in "<keyId>=<secret>" form, read by the archive.
ARCHIVE_TRUSTED_KEYS=primary=<the same archive secret>

# --- Public addressing -----------------------------------------------------
# Host ports published by docker-compose.yml; the containers keep 8080 (archive) and 7001
# (lobby). A second stack beside this one needs its own values, and every tunnel that fronts
# it must target the host port it actually publishes.
ARCHIVE_HTTP_PORT=8069
LOBBY_HTTP_PORT=7001

# The UDP port players connect to for races. Must be reachable from outside.
GM_GAME_PORT=7002

# The game master's public name. Players are sent the address this resolves to, so it must
# exist publicly and point at the machine running the game-master service (A/AAAA - UDP is not
# proxied by a tunnel). Left at localhost, only a client on this machine can join a race.
GM_PUBLIC_HOST=game-nfmw.puppykitty.racing

# The archive's public origin. Must not be the game's own origin if uploads are served there.
ARCHIVE_PUBLIC_URL=http://localhost:8080

# --- Archive web human verification ----------------------------------------
# Use the secret for existing Turnstile sitekey 0x4AAAAAAF8y76GGmumUX1_K. Never commit it.
TURNSTILE_SECRET=
# Exact production website hostnames, comma separated; no localhost, schemes or wildcards.
TURNSTILE_HOSTNAMES=

# --- Optional --------------------------------------------------------------
# Discord sign-in. Leave blank and registration is username/password only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

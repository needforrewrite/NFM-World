<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>ShaderPoc</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
        <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    </ItemGroup>

    <!-- Generated bundles are output, not input, and the nested check project has its
         own obj/ that must not be globbed into this one. -->
    <ItemGroup>
        <Compile Remove="*.g.cs" />
        <Compile Remove="BundleCheck/**" />
        <!-- build-all.sh's default output directory: these are bundles the compiler produced,
             not sources it compiles. -->
        <Compile Remove="generated/**" />
    </ItemGroup>

</Project>

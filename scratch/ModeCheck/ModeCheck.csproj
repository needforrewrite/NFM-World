<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway harness (not in the solution): checks SdlWindow.GetFullscreenDisplayModes()
       headlessly - SDL video init and the display query need no window and no event loop, so
       unlike the FNA3D smoke test this exits on its own. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ModeCheck</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NFMWorld.Platform.SDL3\NFMWorld.Platform.SDL3.csproj" />
    <!-- Direct so the HiDPI probe can call SDL_GetWindowSizeInPixels / GetDisplayContentScale. -->
    <ProjectReference Include="..\..\FNA\lib\SDL3-CS\SDL3\SDL3.Core.csproj" />
  </ItemGroup>

  <!-- Same native deployment the FNA3D smoke test uses: SDL3.dll straight into the output dir. -->
  <ItemGroup>
    <None Include="..\..\NFMWorld.NativeLibs\libs\x64\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

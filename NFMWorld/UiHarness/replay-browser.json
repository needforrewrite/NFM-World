{
  "width": 1280,
  "height": 720,
  "scale": 1,
  "output": "../../scratch/replay-browser-captures",
  "view": "replay-browser",
  "steps": [
    {
      "action": "capture",
      "capture": "local"
    },
    {
      "action": "assert-visible",
      "target": "Replay browser panel"
    },
    {
      "action": "assert-no-horizontal-scroll",
      "target": "Replay list"
    },
    {
      "action": "assert-min-height",
      "target": "Replay list",
      "height": 200
    },
    {
      "action": "hover",
      "target": "Replay upload all",
      "capture": "hover-upload"
    },
    {
      "action": "assert-hover",
      "target": "Replay upload all"
    },
    {
      "action": "click",
      "target": "Replay row data/tts/b.timetrial",
      "capture": "selected-local"
    },
    {
      "action": "assert-visible",
      "target": "Replay play"
    },
    {
      "action": "assert-visible",
      "target": "Replay upload"
    },
    {
      "action": "click",
      "target": "Replay upload",
      "capture": "individual-upload"
    },
    {
      "action": "click",
      "target": "Replay delete",
      "capture": "delete-confirmation"
    },
    {
      "action": "assert-visible",
      "target": "Replay delete confirmation"
    },
    {
      "action": "click",
      "target": "Replay delete cancel",
      "capture": "delete-cancelled"
    },
    {
      "action": "assert-visible",
      "target": "Replay row data/tts/b.timetrial"
    },
    {
      "action": "click",
      "target": "Replay delete"
    },
    {
      "action": "click",
      "target": "Replay delete confirm",
      "capture": "delete-confirmed"
    },
    {
      "action": "click",
      "target": "Replay source online",
      "capture": "online"
    },
    {
      "action": "assert-no-horizontal-scroll",
      "target": "Replay list"
    },
    {
      "action": "assert-visible",
      "target": "Replay row archive:101"
    },
    {
      "action": "click",
      "target": "Replay row archive:101",
      "capture": "selected-online"
    },
    {
      "action": "click",
      "target": "Replay play",
      "capture": "explicit-play"
    },
    {
      "action": "assert-visible",
      "target": "Replay more"
    },
    {
      "action": "click",
      "target": "Replay more",
      "capture": "online-error"
    },
    {
      "action": "click",
      "target": "Replay source local",
      "capture": "local-again"
    },
    {
      "action": "scroll",
      "target": "Replay list",
      "delta": -600,
      "capture": "local-scrolled"
    },
    {
      "action": "click",
      "target": "Replay search"
    },
    {
      "action": "text",
      "value": "long/custom"
    },
    {
      "action": "key",
      "value": "Enter"
    },
    {
      "action": "capture",
      "capture": "local-filtered"
    },
    {
      "action": "assert-no-horizontal-scroll",
      "target": "Replay list"
    }
  ]
}

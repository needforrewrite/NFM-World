{
  "width": 1280,
  "height": 720,
  "scale": 1,
  "output": "../../.git/sx-lobby-match-live-captures",
  "view": "lobby-match-live",
  "steps": [
    { "action": "capture", "capture": "live" },
    { "action": "assert-visible", "target": "Lobby match status" },
    { "action": "assert-visible", "target": "Lobby match live standings" },
    { "action": "assert-visible", "target": "Lobby power maxine" },
    { "action": "assert-visible", "target": "Lobby damage maxine" },
    { "action": "assert-pixel", "target": "Lobby power maxine track", "u": 0.2, "v": 0.5, "rgb": [128, 216, 244] },
    { "action": "assert-pixel", "target": "Lobby damage DR Monstaa track", "u": 0.09, "v": 0.5, "rgb": [244, 244, 11] },
    { "action": "assert-pixel", "target": "Lobby standing maxine", "u": 0.25, "v": 0.5, "rgb": [128, 216, 244], "exclude": true },
    { "action": "assert-visible", "target": "Lobby result tiki" },
    { "action": "assert-visible", "target": "Lobby chat send" },
    { "action": "hover", "target": "Lobby match stage", "capture": "stage-hover" },
    { "action": "assert-visible", "target": "Lobby stage preview button" },
    { "action": "hover", "target": "Lobby stage preview button", "capture": "preview-button-hover" },
    { "action": "assert-hover", "target": "Lobby stage preview button" },
    { "action": "click", "target": "Lobby stage preview button", "capture": "stage-preview" },
    { "action": "assert-visible", "target": "Lobby match overlay" },
    { "action": "assert-visible", "target": "Lobby stage preview" },
    { "action": "assert-min-height", "target": "Lobby stage preview", "height": 240 },
    { "action": "assert-visible", "target": "Lobby match" },
    { "action": "click", "target": "Lobby match overlay close", "capture": "stage-preview-closed" },
    { "action": "hover", "target": "Lobby match stage" },
    { "action": "assert-hover", "target": "Lobby match stage" },
    { "action": "click", "target": "Lobby stage preview button" },
    { "action": "assert-visible", "target": "Lobby stage preview" },
    { "action": "click", "x": 8, "y": 8 },
    { "action": "hover", "target": "Lobby match stage" },
    { "action": "assert-hover", "target": "Lobby match stage" },
    { "action": "hover", "target": "Lobby game rules button", "capture": "rules-button-hover" },
    { "action": "assert-hover", "target": "Lobby game rules button" },
    { "action": "click", "target": "Lobby game rules button", "capture": "rules" },
    { "action": "assert-visible", "target": "Lobby game rules" },
    { "action": "click", "target": "Lobby match overlay close" }
  ]
}
